{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2020"],
    "types": ["miniprogram-api-typings", "node"]
  },
  "include": [
    "miniprogram/**/*.ts",
    "miniprogram/**/*.d.ts",
    "tests/**/*.ts"
  ]
}
