.custom-tab-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 16rpx;
  z-index: 60;
  box-sizing: border-box;
  padding: 0 12rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 17, 17, 0.05);
  border-radius: var(--radius-lg);
}

.tab-bar-inner {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 96rpx;
  padding: 12rpx 0 calc(env(safe-area-inset-bottom) + 12rpx);
  box-sizing: border-box;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

.tab-label {
  color: #7c8390;
  font-size: var(--font-caption);
  font-weight: 500;
  line-height: 1.2;
}

.tab-item.is-active .tab-icon {
  transform: translateY(-1rpx);
}

.tab-item.is-active .tab-label {
  color: #111111;
  font-weight: 600;
}
