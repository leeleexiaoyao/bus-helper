<view class="page-shell join-trip-page">
  <view class="join-title">请输入6位口令</view>

  <view class="form-block">
    <view class="code-input-list">
      <input
        wx:for="{{passwordDigits}}"
        wx:key="index"
        class="code-input {{focusIndex === index ? 'is-active' : ''}}"
        value="{{item}}"
        data-index="{{index}}"
        maxlength="6"
        type="number"
        focus="{{focusIndex === index}}"
        cursor-spacing="24"
        bindfocus="handleDigitFocus"
        bindinput="handleDigitInput"
      />
    </view>
  </view>

  <button class="join-submit-btn" loading="{{submitting}}" bindtap="handleSubmit">
    加入车次
  </button>
</view>
