.home-page {
  min-height: 100vh;
  position: relative;
  padding-top: 0;
  padding-right: 0;
  padding-left: 0;
  padding-bottom: 40rpx;
  background: #f5f6f9;
}

.home-page-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(180deg, #3495f6 0%, #78bbff 100%);
  z-index: 0;
}

auth-gate {
  display: block;
  margin: 0 20rpx;
  position: relative;
  z-index: 1;
}

.home-hero {
  padding: 10rpx 24rpx 90rpx;
  position: relative;
  z-index: 1;
}

.viewer-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 120rpx;
}

.viewer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.72);
}

.viewer-avatar--fallback {
  display: block;
}

.viewer-copy {
  flex: 1;
  min-width: 0;
}

.viewer-name {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.3;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.viewer-seat {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
}

.viewer-profile {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.viewer-meta {
  flex: 1;
  min-width: 0;
}

.viewer-persona-action {
  width: 196rpx;
  min-height: 128rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  flex-shrink: 0;
}

.viewer-persona-image {
  width: 260rpx;
  display: block;
  margin-right: 80rpx;
  transform: translateY(80rpx);
}

.viewer-persona-button {
  height: 60rpx;
  padding: 0 38rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.trip-panel {
  margin-top: -62rpx;
  margin-right: 0;
  margin-bottom: 24rpx;
  margin-left: 0;
  padding: 36rpx 0 44rpx;
  min-height: calc(100vh - 368rpx);
  box-sizing: border-box;
  background: #f5f6f9;
  border-radius: 40rpx 40rpx 0 0;
  overflow: hidden;
  position: relative;
  z-index: 2;
}

.trip-tabs {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: center;
  padding: 0 24rpx;
}

.tabs-left {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.home-tab {
  position: relative;
  color: rgba(0, 0, 0, 0.3);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.2;
}

.home-tab.is-active {
  color: #000000;
  opacity: 1;
  font-weight: 500;
}

.tabs-stat {
  color: rgba(0, 0, 0, 0.3);
  font-size: 22rpx;
}

.entry-card {
  margin: 0 20rpx;
  padding: 34rpx 28rpx;
  position: relative;
  z-index: 1;
}

.entry-actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
