.home-page {
  min-height: 100vh;
  position: relative;
  padding-top: 0;
  padding-right: 0;
  padding-left: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  background: #f3f2ef;
}

.home-bg-hero {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 454rpx;
  background: linear-gradient(180deg, #ecfbbb 0%, #f4f4f3 100%);
  pointer-events: none;
  z-index: 0;
}

.home-header {
  padding: 0 32rpx;
  margin-top: -44rpx;
  min-height: 136rpx;
  position: relative;
  z-index: 1;
}

.home-header-copy {
  position: relative;
  z-index: 1;
  max-width: calc(100% - 236rpx);
}

.home-title {
  color: #111111;
  font-size: 56rpx;
  line-height: 1.18;
  font-weight: 900;
}

.home-subtitle {
  margin-top: 10rpx;
  color: #6f7783;
  font-size: 24rpx;
  line-height: 1.38;
}

.home-header-figure {
  position: absolute;
  right: 118rpx;
  top: -2rpx;
  width: 236rpx;
  z-index: 0;
  pointer-events: none;
}

.home-user-card {
  margin: 22rpx 32rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 34rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.home-user-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.home-user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #dde8ef;
}

.home-user-copy {
  min-width: 0;
  flex: 1;
}

.home-user-greeting {
  color: #111111;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.home-user-wish {
  margin-top: 10rpx;
  color: #8c9199;
  font-size: 24rpx;
  line-height: 1.2;
}

.home-boarding-btn {
  width: 180rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #d8f940;
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.home-boarding-btn.is-active {
  background: rgba(17, 17, 17, 0.08);
  color: #8c9199;
}

.home-boarding-btn.is-disabled {
  opacity: 1;
  background: rgba(17, 17, 17, 0.08);
  color: #b6bac1;
}

.home-boarding-btn.is-active.is-disabled {
  background: rgba(17, 17, 17, 0.08);
  color: #8c9199;
}

.trip-panel {
  margin: 26rpx 32rpx 0;
  padding: 28rpx 24rpx 24rpx;
  min-height: calc(100vh - 410rpx);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 40rpx;
  position: relative;
  z-index: 2;
}

.trip-tabs {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: center;
  padding: 0 24rpx;
}

.tabs-left {
  display: flex;
  gap: 40rpx;
  align-items: center;
}

.home-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 18rpx;
  color: #7c8390;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.2;
}

.home-tab.is-active {
  color: #111111;
  opacity: 1;
  font-weight: 700;
}

.home-tab-line {
  position: absolute;
  left: 50%;
  bottom: -2rpx;
  width: 52rpx;
  margin-top: 0;
  flex-shrink: 0;
  transform: translateX(-50%);
}

.tabs-stat {
  color: #b6bac1;
  font-size: 24rpx;
  line-height: 1.2;
}

.trip-meta-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
  transform: translateY(-12rpx);
}

.trip-switch-trigger {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.06);
}

.trip-switch-trigger-label {
  color: #111111;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.trip-switch-trigger-icon {
  width: 20rpx;
  height: 20rpx;
}

.trip-content-card {
  margin-top: 0rpx;
  margin-left: -24rpx;
  margin-right: -24rpx;
  padding: 0 20rpx 8rpx;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}

.entry-card {
  min-height: calc(100vh - 360rpx);
  padding: 0 24rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.entry-title {
  color: #111111;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 700;
  text-align: center;
}

.entry-copy {
  margin-top: 16rpx;
  color: #6f7783;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
}

.entry-actions {
  width: 100%;
  max-width: 520rpx;
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry-primary-btn,
.entry-secondary-btn {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 88rpx;
  box-sizing: border-box;
}

.entry-primary-btn {
  background: #d8f940;
  color: #111111;
}

.entry-secondary-btn {
  background: #ffffff;
  color: #111111;
  border: 2rpx solid #e8ecf1;
}

.entry-primary-btn::after,
.entry-secondary-btn::after {
  border: none;
}
