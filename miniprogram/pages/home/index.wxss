.home-page {
  min-height: 100vh;
  position: relative;
  padding-top: 40rpx;
  padding-right: 0;
  padding-left: 0;
  padding-bottom: 40rpx;
  background: linear-gradient(180deg, #8dbaf5 0%, #97bff4 18%, #b7d1f6 38%, #dbe8fb 58%, #ffffff 82%);
}

auth-gate {
  display: block;
  margin: 0 24rpx;
  position: relative;
  z-index: 1;
}

.home-hero {
  padding: 0 24rpx;
  position: relative;
  z-index: 1;
}

.viewer-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 8rpx;
  padding-left: 2rpx;
}

.viewer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.72);
}

.viewer-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #d78871 0%, #dd9d86 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.viewer-copy {
  flex: 1;
}

.viewer-name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.viewer-seat {
  margin-top: 8rpx;
  color: rgba(17, 17, 17, 0.72);
  font-size: 22rpx;
}

.trip-panel {
  margin-top: 42rpx;
  margin-left: 20rpx;
  margin-right: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 16rpx 44rpx;
  min-height: calc(100vh - 388rpx);
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 40rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.trip-tabs {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
  padding: 0 16rpx 8rpx;
}

.tabs-left {
  display: flex;
  gap: 46rpx;
  align-items: center;
}

.home-tab {
  position: relative;
  padding-bottom: 8rpx;
  color: #9d9d9d;
  font-size: 34rpx;
  font-weight: 500;
}

.home-tab.is-active {
  color: var(--text-primary);
  font-weight: 700;
}

.tabs-stat {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.entry-card {
  margin: 0 24rpx;
  padding: 34rpx 28rpx;
  position: relative;
  z-index: 1;
}

.entry-actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
