<page-meta page-style="{{sheetVisible || showPersonaSheet ? 'height: 100vh; overflow: hidden;' : ''}}" />
<view class="page-shell home-page">
  <page-navbar title="{{navTitle}}" progress="{{navProgress}}" theme="dark" leftPadding="{{32}}" titleFontSize="{{20}}" />

  <view class="home-bg-hero"></view>

  <block wx:if="{{showAuthGate}}">
    <auth-gate
      title="先授权头像和昵称"
      subtitle="首次使用前，请完成微信头像和昵称授权。授权成功后才能创建车次、加入车次和查看成员信息。"
      presetNickname="{{authPresetNickname}}"
      presetAvatarUrl="{{authPresetAvatarUrl}}"
      bindauthorized="handleAuthorizeProfile"
    />
  </block>

  <block wx:if="{{showTripContent}}">
    <view class="home-header">
      <view class="home-header-copy">
        <view class="home-title">{{navTitle}}</view>
        <view class="home-subtitle">{{currentTrip.tripMeta.departureTime}}出发~</view>
      </view>
      <image class="home-header-figure" src="/assets/icons/pic_homepage_chufa.png" mode="widthFix" />
    </view>

    <view class="home-user-card">
      <view class="home-user-main">
        <image
          wx:if="{{currentUser.avatarUrl}}"
          class="home-user-avatar"
          src="{{currentUser.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="home-user-avatar avatar-fallback">{{currentUserInitial}}</view>

        <view class="home-user-copy">
          <view class="home-user-greeting">👋 Hi，{{currentUser.nickname}}</view>
          <view class="home-user-wish">旅途愉快~</view>
        </view>
      </view>

      <view class="home-seat-summary">
        <view class="home-seat-tag">我的座位</view>
        <view class="home-seat-value {{viewerSeatText === '请选择您的座位' ? 'is-placeholder' : ''}}">{{viewerSeatText}}</view>
      </view>
    </view>

    <view class="trip-panel">
      <view class="trip-tabs">
        <view class="tabs-left">
          <view class="{{seatsTabClassName}}" data-tab="seats" bindtap="handleTabChange">
            <text>座位图</text>
            <image wx:if="{{isSeatsTab}}" class="home-tab-line" src="/assets/icons/pic_tabbar_selectedline.svg" mode="widthFix" />
          </view>
          <view class="{{membersTabClassName}}" data-tab="members" bindtap="handleTabChange">
            <text>成员列表</text>
            <image wx:if="{{isMembersTab}}" class="home-tab-line" src="/assets/icons/pic_tabbar_selectedline.svg" mode="widthFix" />
          </view>
        </view>
        <view class="tabs-stat">已入座 {{currentTrip.tripMeta.seatedCount}} / {{currentTrip.tripMeta.seatCount}}</view>
      </view>

      <view class="trip-content-card">
        <seat-grid wx:if="{{isSeatsTab}}" rows="{{currentTrip.seatRows}}" bindseattap="handleSeatTap" />
        <member-list wx:else members="{{seatedMembers}}" bindmembertap="handleMemberTap" />
      </view>
    </view>
  </block>

  <block wx:if="{{showTripEntry}}">
    <view class="entry-card card" style="border-radius: 32rpx; overflow: hidden; background: #ffffff;">
      <view class="section-title">先创建或加入一个车次</view>
      <view class="section-subtitle">
        授权完成后，你就可以开始认座、查看成员列表，并在“我的”页维护自己的标签信息。
      </view>

      <view class="entry-actions">
        <button class="primary-btn" bindtap="goCreateTrip">创建车次</button>
        <button class="secondary-btn" bindtap="goJoinTrip">加入车次</button>
      </view>
    </view>
  </block>
</view>

<persona-sheet
  visible="{{showPersonaSheet}}"
  active="{{personaSheetActive}}"
  options="{{personaOptions}}"
  selectedId="{{personaDraftId}}"
  bindselect="handlePersonaSelect"
  bindcancel="handlePersonaCancel"
  bindconfirm="handlePersonaConfirm"
/>

<seat-sheet
  visible="{{sheetVisible}}"
  mode="{{sheetMode}}"
  seat="{{selectedSeat}}"
  member="{{selectedMember}}"
  bindclose="handleSheetClose"
  bindconfirmclaim="handleClaimConfirm"
  bindreleasemine="handleReleaseMine"
  bindadminrelease="handleAdminRelease"
  bindtogglefavorite="handleToggleFavorite"
/>
