<page-meta page-style="{{sheetVisible || showPersonaSheet ? 'height: 100vh; overflow: hidden;' : ''}}" />
<view class="page-shell home-page">
  <view class="home-page-bg"></view>
  <page-navbar title="{{navTitle}}" progress="{{navProgress}}" theme="light" leftPadding="{{12}}" titleFontSize="{{18}}" />

  <block wx:if="{{showAuthGate}}">
    <auth-gate
      title="先授权头像和昵称"
      subtitle="首次使用前，先用演示身份完成一次模拟授权。授权成功后才能创建车次、加入车次和查看成员信息。"
      presetNickname="{{authPresetNickname}}"
      presetAvatarUrl="{{authPresetAvatarUrl}}"
      bindauthorized="handleAuthorizeProfile"
    />
  </block>

  <block wx:if="{{showTripContent}}">
    <view class="home-hero">
      <view class="viewer-row">
        <view class="viewer-meta">
          <view class="viewer-profile">
            <image
              wx:if="{{currentUser.avatarUrl}}"
              class="viewer-avatar"
              src="{{currentUser.avatarUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="viewer-avatar viewer-avatar--fallback avatar-fallback">{{currentUserInitial}}</view>

            <view class="viewer-copy">
              <view class="viewer-name">{{currentUser.nickname}}</view>
              <view class="viewer-seat">座位号:{{viewerSeatText}}</view>
            </view>
          </view>
        </view>

        <view class="viewer-persona-action" bindtap="handleOpenPersonaSheet">
          <image wx:if="{{currentPersonaImageUrl}}" class="viewer-persona-image" src="{{currentPersonaImageUrl}}" mode="widthFix" />
          <view wx:else class="viewer-persona-button">添加形象</view>
        </view>
      </view>
    </view>

    <view class="trip-panel">
      <view class="trip-tabs">
        <view class="tabs-left">
          <view class="{{seatsTabClassName}}" data-tab="seats" bindtap="handleTabChange">座位图</view>
          <view class="{{membersTabClassName}}" data-tab="members" bindtap="handleTabChange">成员列表</view>
        </view>
        <view class="tabs-stat">已入座{{currentTrip.tripMeta.seatedCount}}/{{currentTrip.tripMeta.seatCount}}</view>
      </view>

      <seat-grid wx:if="{{isSeatsTab}}" rows="{{currentTrip.seatRows}}" bindseattap="handleSeatTap" />
      <member-list wx:else members="{{seatedMembers}}" bindmembertap="handleMemberTap" />
    </view>
  </block>

  <block wx:if="{{showTripEntry}}">
    <view class="entry-card card" style="border-radius: 32rpx; overflow: hidden; background: #ffffff;">
      <view class="section-title">先创建或加入一个车次</view>
      <view class="section-subtitle">
        授权完成后，你就可以开始认座、查看成员列表，并在“我的”页维护自己的标签信息。
      </view>

      <view class="entry-actions">
        <button class="primary-btn" bindtap="goCreateTrip">创建车次</button>
        <button class="secondary-btn" bindtap="goJoinTrip">加入车次</button>
      </view>
    </view>
  </block>
</view>

<persona-sheet
  visible="{{showPersonaSheet}}"
  active="{{personaSheetActive}}"
  options="{{personaOptions}}"
  selectedId="{{personaDraftId}}"
  bindselect="handlePersonaSelect"
  bindcancel="handlePersonaCancel"
  bindconfirm="handlePersonaConfirm"
/>

<seat-sheet
  visible="{{sheetVisible}}"
  mode="{{sheetMode}}"
  seat="{{selectedSeat}}"
  member="{{selectedMember}}"
  bindclose="handleSheetClose"
  bindconfirmclaim="handleClaimConfirm"
  bindreleasemine="handleReleaseMine"
  bindadminrelease="handleAdminRelease"
/>
