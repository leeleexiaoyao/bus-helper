<page-meta page-style="{{sheetVisible || showPersonaSheet || showAuthGate ? 'height: 100vh; overflow: hidden;' : ''}}" />
<view class="page-shell home-page">
  <page-navbar title="{{navTitle}}" progress="{{navProgress}}" theme="dark" leftPadding="{{32}}" titleFontSize="{{20}}" />

  <view class="home-bg-hero"></view>

  <block wx:if="{{showTripContent}}">
    <view class="home-header">
      <view class="home-header-copy">
        <view class="home-title">{{navTitle}}</view>
        <view class="home-subtitle">{{currentTrip.tripMeta.departureTime}}出发~</view>
      </view>
      <image class="home-header-figure" src="/assets/icons/pic_homepage_chufa.png" mode="widthFix" />
    </view>

    <view class="home-user-card">
      <view class="home-user-main">
        <image
          wx:if="{{currentUser.avatarUrl}}"
          class="home-user-avatar"
          src="{{currentUser.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="home-user-avatar avatar-fallback">{{currentUserInitial}}</view>

        <view class="home-user-copy">
          <view class="home-user-greeting">👋 Hi，{{currentUser.nickname}}</view>
          <view class="home-user-wish">{{viewerSeatSummary}}</view>
        </view>
      </view>

      <view
        class="home-boarding-btn {{boardingButton.isActive ? 'is-active' : ''}} {{boardingButton.isDisabled ? 'is-disabled' : ''}}"
        hover-class="none"
        bindtap="handleBoardingTap"
      >
        {{boardingButton.label}}
      </view>
    </view>

    <view class="trip-panel">
      <view class="trip-tabs">
        <view class="tabs-left">
          <view class="home-tab is-active">
            <text>座位图</text>
            <image class="home-tab-line" src="/assets/icons/pic_tabbar_selectedline.svg" mode="widthFix" />
          </view>
        </view>
        <view class="trip-meta-right">
          <view class="tabs-stat">已入座 {{currentTrip.tripMeta.seatedCount}} / {{currentTrip.tripMeta.seatCount}}</view>
          <view class="trip-switch-trigger" bindtap="handleOpenTripSwitcher">
            <text class="trip-switch-trigger-label">{{currentTripLabel}}</text>
            <image class="trip-switch-trigger-icon" src="/assets/icons/icon_homepage_switch.svg" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="trip-content-card">
        <seat-grid rows="{{currentTrip.seatRows}}" bindseattap="handleSeatTap" />
      </view>
    </view>
  </block>
</view>

<persona-sheet
  visible="{{showPersonaSheet}}"
  active="{{personaSheetActive}}"
  options="{{personaOptions}}"
  selectedId="{{personaDraftId}}"
  bindselect="handlePersonaSelect"
  bindcancel="handlePersonaCancel"
  bindconfirm="handlePersonaConfirm"
/>

<seat-sheet
  visible="{{sheetVisible}}"
  mode="{{sheetMode}}"
  seat="{{selectedSeat}}"
  member="{{selectedMember}}"
  tripLabel="{{currentTripLabel}}"
  confirmTitle="{{seatConfirmTitle}}"
  bindclose="handleSheetClose"
  bindconfirmclaim="handleClaimConfirm"
  bindreleasemine="handleReleaseMine"
  bindadminrelease="handleAdminRelease"
  bindtogglefavorite="handleToggleFavorite"
/>
