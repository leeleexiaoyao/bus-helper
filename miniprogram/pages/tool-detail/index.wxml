<view class="tool-detail-page {{toolType === 'seat-draw' ? 'tool-detail-page--seat-draw' : ''}} {{pageData && pageData.isAdmin && (!pageData.isStarted || isDraftEditing) ? 'tool-detail-page--editor' : ''}}">
  <view class="custom-nav-spacer" style="height: {{navTotalHeight}}px;"></view>

  <view class="custom-nav" style="height: {{navTotalHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav-inner" style="height: {{navHeight}}px; padding-left: {{navRightPadding}}px; padding-right: {{navRightPadding}}px;">
      <view class="custom-back" bindtap="handleBack">
        <view class="custom-back-icon"></view>
      </view>
      <view class="custom-nav-title">{{toolTitle}}</view>
    </view>
  </view>

  <view class="page-shell tool-detail-content">
    <block wx:if="{{pageData}}">
      <block wx:if="{{pageData.toolType === 'seat-draw'}}">
        <block wx:if="{{!pageData.isStarted && pageData.isAdmin && !isDraftEditing}}">
          <view class="seat-draw-empty-wrap seat-draw-empty-wrap--admin">
            <view class="seat-draw-empty-hint">随机从车上成员里抽取1位或多位小伙伴</view>
            <button class="primary-btn detail-btn seat-draw-primary-btn seat-draw-empty-btn" bindtap="handleCreateDraft">创建玩法</button>
          </view>
        </block>

        <block wx:elif="{{!pageData.isStarted && !pageData.isAdmin}}">
          <view class="seat-draw-empty-wrap seat-draw-empty-wrap--viewer">
            <view class="seat-draw-viewer-empty">🙋‍♀️ 暂未开放</view>
          </view>
        </block>

        <block wx:elif="{{pageData.isAdmin && isDraftEditing}}">
          <view class="card seat-draw-editor-card">
            <view class="seat-draw-editor-row">
              <view class="seat-draw-editor-label">主题名称</view>
              <input
                class="seat-draw-editor-input"
                value="{{seatDrawTopicInput}}"
                maxlength="20"
                placeholder="请输入主题名称，20个字以内"
                placeholder-class="field-placeholder"
                bindinput="handleSeatDrawTopicInput"
              />
            </view>

            <view class="seat-draw-editor-row">
              <view class="seat-draw-editor-label">抽号人数</view>
              <picker range="{{drawCountOptions}}" value="{{drawCountPickerValue}}" bindchange="handleSeatDrawCountChange">
                <view class="seat-draw-editor-select">
                  <text class="seat-draw-editor-select-text">{{seatDrawCountLabel}}</text>
                  <text class="seat-draw-editor-select-arrow">▾</text>
                </view>
              </picker>
            </view>

            <view class="seat-draw-switch-row">
              <view class="seat-draw-switch-text">多次抽取剔除重复号码</view>
              <switch checked="{{seatDrawExcludePreviouslyDrawn}}" bindchange="handleSeatDrawExcludeHistoryChange" color="#2f7cff" />
            </view>

            <view class="seat-draw-switch-row">
              <view class="seat-draw-switch-text">不包含管理员</view>
              <switch checked="{{seatDrawExcludeAdmin}}" bindchange="handleSeatDrawExcludeAdminChange" color="#2f7cff" />
            </view>

            <button class="primary-btn detail-btn seat-draw-primary-btn seat-draw-editor-btn" bindtap="handleSeatDrawPublish">立即创建</button>
          </view>
        </block>

        <block wx:elif="{{pageData.isStarted && pageData.seatDrawDetail}}">
          <tool-hero-shell
            cardClassName="tool-hero-card--seat-draw"
            bodyClassName="tool-hero-body--seat-draw"
            eyebrowText="{{heroView.eyebrowText}}"
            titleText="{{heroView.titleText}}"
            subtitleText="{{heroView.subtitleText}}"
            illustrationSrc="{{heroView.illustrationSrc}}"
            illustrationClassName="{{heroView.illustrationClassName}}"
          >
            <view class="{{seatDrawMachineClass}}">
              <view class="seat-draw-machine-handle seat-draw-machine-handle--left"></view>
              <view class="seat-draw-machine-shell">
                <view class="seat-draw-machine-window">
                  <view class="seat-draw-slot seat-draw-slot--machine" wx:for="{{pageData.seatDrawDetail.displaySlots}}" wx:key="id">
                    <text class="{{item.isPlaceholder ? 'seat-draw-slot-text seat-draw-slot-text--placeholder' : 'seat-draw-slot-text'}}">{{item.label}}</text>
                  </view>
                </view>
              </view>
              <view class="seat-draw-machine-handle seat-draw-machine-handle--right"></view>
            </view>

            <view slot="footer">
              <block wx:if="{{pageData.isAdmin}}">
                <button
                  wx:if="{{pageData.seatDrawDetail.phase === 'ready'}}"
                  class="detail-btn tool-hero-btn tool-hero-btn--primary"
                  bindtap="handleSeatDrawRun"
                  disabled="{{pageData.seatDrawDetail.remainingCount === 0}}"
                >
                  开始抽号
                </button>

                <block wx:elif="{{pageData.seatDrawDetail.phase === 'rolling'}}">
                  <button class="detail-btn tool-hero-btn tool-hero-btn--disabled" disabled>抽号中...</button>
                  <button class="detail-btn tool-hero-btn tool-hero-btn--primary tool-hero-btn--secondary" hover-class="none">再抽一次</button>
                </block>

                <block wx:else>
                  <button class="detail-btn tool-hero-btn tool-hero-btn--disabled" disabled>抽号已结束</button>
                  <button class="detail-btn tool-hero-btn tool-hero-btn--primary tool-hero-btn--secondary" bindtap="handleSeatDrawRun" disabled="{{!pageData.seatDrawDetail.canDrawAgain}}">
                    再抽一次
                  </button>
                </block>
              </block>

              <block wx:else>
                <view class="tool-hero-status" wx:if="{{pageData.seatDrawDetail.phase === 'ready'}}">抽号即将开始</view>
                <view class="tool-hero-status" wx:elif="{{pageData.seatDrawDetail.phase === 'rolling'}}">抽号即将开始</view>
                <view class="tool-hero-status tool-hero-status--ended" wx:else>已结束</view>
              </block>
            </view>
          </tool-hero-shell>

          <view
            wx:if="{{pageData.isAdmin && pageData.seatDrawDetail.phase === 'rolling'}}"
            class="seat-draw-more-action seat-draw-more-action--disabled"
          >
            更多操作
          </view>
          <view
            wx:elif="{{pageData.isAdmin}}"
            class="seat-draw-more-action"
            bindtap="handleOpenActionSheet"
          >
            更多操作
          </view>

          <tool-result-shell
            cardClassName="seat-draw-result-card"
            title="{{heroView.resultTitle}}"
            showEmpty="{{!pageData.seatDrawDetail.resultRounds.length}}"
            emptyText="暂无记录"
          >
            <view class="seat-draw-result-item" wx:for="{{pageData.seatDrawDetail.resultRounds}}" wx:key="id">
              <text class="seat-draw-result-index">{{index + 1}}.</text>
              <text class="seat-draw-result-value">{{item.displayText}}</text>
            </view>
          </tool-result-shell>
        </block>
      </block>

      <block wx:if="{{pageData.toolType === 'vote'}}">
        <block wx:if="{{!pageData.isStarted && pageData.isAdmin && !isDraftEditing}}">
          <view class="tool-empty-wrap tool-empty-wrap--admin">
            <view class="tool-empty-copy">发起全员投票，支持单选、多选和最多可选项设置。</view>
            <button class="primary-btn detail-btn seat-draw-primary-btn tool-empty-btn" bindtap="handleCreateDraft">创建玩法</button>
          </view>
        </block>

        <block wx:elif="{{!pageData.isStarted && !pageData.isAdmin}}">
          <view class="tool-empty-wrap tool-empty-wrap--viewer">
            <view class="tool-viewer-empty">暂未开放</view>
          </view>
        </block>

        <block wx:elif="{{pageData.isAdmin && isDraftEditing}}">
          <view class="tool-editor-panel">
            <view class="tool-editor-row">
              <view class="tool-editor-label">主题名称</view>
              <input
                class="tool-editor-input"
                value="{{voteTopicInput}}"
                maxlength="30"
                placeholder="请输入主题名称"
                placeholder-class="field-placeholder"
                bindinput="handleVoteTopicInput"
              />
            </view>

            <view class="tool-editor-field">
              <view class="tool-editor-label">投票选项</view>
              <textarea
                class="tool-editor-textarea"
                value="{{voteOptionsInput}}"
                maxlength="240"
                placeholder="一行一个选项"
                placeholder-class="field-placeholder"
                bindinput="handleVoteOptionsInput"
              />
            </view>

            <view class="mode-row tool-editor-inline">
              <view class="mode-title tool-editor-label">投票方式</view>
              <view class="mode-switches">
                <view class="{{voteModeSingleClass}}" data-mode="single" bindtap="handleVoteModeSelect">单选</view>
                <view class="{{voteModeMultipleClass}}" data-mode="multiple" bindtap="handleVoteModeSelect">多选</view>
              </view>
            </view>

            <view class="tool-editor-row" wx:if="{{voteSelectionMode === 'multiple'}}">
              <view class="tool-editor-label">最多可选</view>
              <input
                class="tool-editor-input"
                type="number"
                value="{{voteMaxSelectionsInput}}"
                placeholder="请输入最多可选项数"
                placeholder-class="field-placeholder"
                bindinput="handleVoteMaxSelectionsInput"
              />
            </view>

            <view class="switch-row tool-editor-inline">
              <view class="switch-copy-wrap">
                <view class="switch-title tool-editor-label">去除管理员</view>
              </view>
              <switch checked="{{voteExcludeAdmin}}" bindchange="handleVoteExcludeAdminChange" color="#2f7cff" />
            </view>

            <button class="primary-btn detail-btn seat-draw-primary-btn tool-editor-btn" bindtap="handleVotePublish">{{isRecreateMode ? '重新创建' : '立即创建'}}</button>
          </view>
        </block>

        <block wx:elif="{{pageData.isStarted && pageData.voteDetail}}">
          <tool-hero-shell
            eyebrowText="{{heroView.eyebrowText}}"
            titleText="{{heroView.titleText}}"
            subtitleText="{{heroView.subtitleText}}"
            illustrationSrc="{{heroView.illustrationSrc}}"
            illustrationClassName="{{heroView.illustrationClassName}}"
          >
            <view>
              <view class="vote-meta-row vote-meta-row--hero vote-meta-row--progress">
                <view class="vote-progress">已投 {{pageData.voteDetail.submittedCount}} / {{pageData.voteDetail.participantCount}}</view>
              </view>

              <view class="vote-options vote-options--hero">
                <view
                  class="{{item.className}}"
                  wx:for="{{voteOptionCards}}"
                  wx:key="id"
                  data-option-id="{{item.id}}"
                  bindtap="handleVoteOptionSelect"
                >
                  <view class="vote-option-copy">
                    <view class="vote-option-title">{{item.title}}</view>
                    <view class="vote-option-label">{{item.label}}</view>
                  </view>
                  <view class="{{item.checkboxClassName}}" wx:if="{{item.showCheckbox}}">
                    <text class="vote-option-checkmark">✓</text>
                  </view>
                  <view class="vote-option-result" wx:if="{{item.showResult}}">
                    <view class="vote-option-result-count">
                      <text class="vote-option-result-number">{{item.supportCountText}}</text>
                      <text class="vote-option-result-unit">票</text>
                    </view>
                    <view class="vote-option-result-rate">{{item.supportRateText}}</view>
                  </view>
                </view>
              </view>
            </view>

            <view slot="footer" wx:if="{{pageData.isAdmin || pageData.voteDetail.viewerEligible}}">
              <button
                wx:if="{{pageData.isAdmin}}"
                class="detail-btn tool-hero-btn {{pageData.voteDetail.phase === 'active' ? 'tool-hero-btn--ghost' : 'tool-hero-btn--disabled'}}"
                bindtap="handleVoteEnd"
                disabled="{{pageData.voteDetail.phase !== 'active'}}"
              >
                {{pageData.voteDetail.phase === 'active' ? '终止' : '已结束'}}
              </button>
              <button
                wx:if="{{pageData.voteDetail.viewerEligible}}"
                class="detail-btn tool-hero-btn {{voteApproveDisabled ? 'tool-hero-btn--disabled' : 'tool-hero-btn--primary'}} {{pageData.isAdmin ? 'tool-hero-btn--secondary' : ''}}"
                data-choice="approve"
                bindtap="handleVoteSubmit"
                disabled="{{voteApproveDisabled || pageData.voteDetail.phase !== 'active'}}"
              >
                {{pageData.voteDetail.viewerHasSubmitted ? '已投' : pageData.voteDetail.phase === 'ended' ? '已结束' : '确定'}}
              </button>
            </view>
          </tool-hero-shell>

          <view class="seat-draw-more-action" wx:if="{{pageData.isAdmin}}" bindtap="handleOpenActionSheet">更多操作</view>

          <tool-result-shell
            title="{{heroView.resultTitle}}"
            showEmpty="{{pageData.voteDetail.phase !== 'ended'}}"
            emptyText="暂无记录"
          >
            <view class="vote-final-list" wx:if="{{pageData.voteDetail.phase === 'ended'}}">
              <view class="vote-final-item" wx:for="{{pageData.voteDetail.resultOptions}}" wx:key="id">
                <view class="vote-final-label">{{index + 1}}. {{item.label}}</view>
                <view class="vote-final-count">{{item.supportCount}} 票</view>
              </view>
            </view>
          </tool-result-shell>
        </block>
      </block>

      <block wx:if="{{pageData.toolType === 'wheel'}}">
        <block wx:if="{{!pageData.isStarted && pageData.isAdmin && !isDraftEditing}}">
          <view class="tool-empty-wrap tool-empty-wrap--admin">
            <button class="primary-btn detail-btn seat-draw-primary-btn tool-empty-btn" bindtap="handleCreateDraft">创建玩法</button>
          </view>
        </block>

        <block wx:elif="{{!pageData.isStarted && !pageData.isAdmin}}">
          <view class="tool-empty-wrap tool-empty-wrap--viewer">
            <view class="tool-viewer-empty">暂未开放</view>
          </view>
        </block>

        <block wx:elif="{{pageData.isAdmin && isDraftEditing}}">
          <view class="tool-editor-panel">
            <view class="tool-editor-row">
              <view class="tool-editor-label">主题名称</view>
              <input
                class="tool-editor-input"
                value="{{wheelTopicInput}}"
                maxlength="30"
                placeholder="请输入主题名称"
                placeholder-class="field-placeholder"
                bindinput="handleWheelTopicInput"
              />
            </view>

            <view class="tool-editor-field">
              <view class="tool-editor-label">奖品项</view>
              <textarea
                class="tool-editor-textarea"
                value="{{wheelItemsInput}}"
                maxlength="200"
                placeholder="一行一个奖品项"
                placeholder-class="field-placeholder"
                bindinput="handleWheelItemsInput"
              />
              <view class="tool-editor-hint">至少 2 项，最多 10 项。</view>
            </view>

            <view class="switch-row tool-editor-inline">
              <view class="switch-copy-wrap">
                <view class="switch-title tool-editor-label">使用人</view>
              </view>
              <switch checked="{{wheelAllowAssignedUser}}" bindchange="handleWheelAllowAssignedUserChange" color="#2f7cff" />
            </view>

            <view class="tool-editor-field" wx:if="{{wheelAllowAssignedUser}}">
              <view class="tool-editor-label">指定成员</view>
              <picker range="{{wheelEligibleUserLabels}}" value="{{wheelAssignedUserIndex}}" bindchange="handleWheelAssignedUserChange">
                <view class="picker-trigger tool-editor-picker">{{wheelEligibleUserLabels[wheelAssignedUserIndex] || '请选择使用成员'}}</view>
              </picker>
            </view>

            <button class="primary-btn detail-btn seat-draw-primary-btn tool-editor-btn" bindtap="handleWheelPublish">{{isRecreateMode ? '重新创建' : '立即创建'}}</button>
          </view>
        </block>

        <block wx:elif="{{pageData.isStarted && pageData.wheelDetail}}">
          <tool-hero-shell
            eyebrowText="{{heroView.eyebrowText}}"
            titleText="{{heroView.titleText}}"
            subtitleText="{{heroView.subtitleText}}"
            illustrationSrc="{{heroView.illustrationSrc}}"
            illustrationClassName="{{heroView.illustrationClassName}}"
          >
            <view>
              <view class="wheel-current-result">
                <view class="wheel-current-result-label">本轮结果</view>
                <view class="wheel-current-result-value">{{wheelSpinning ? '正在转动' : (wheelShowResult && pageData.wheelDetail.resultLabel ? pageData.wheelDetail.resultLabel : '-')}}</view>
              </view>
              <view class="wheel-stage">
                <view class="wheel-shell">
                  <view class="wheel-frame">
                    <image class="wheel-ring-image" src="../../assets/icons/pic_tools_zhuanpan_ring.svg" mode="aspectFit" />

                    <view
                      class="wheel-disc {{wheelSpinning ? 'is-spinning' : ''}}"
                      style="transform: rotate({{wheelRotation}}deg); transition-duration: {{wheelTransitionMs}}ms;"
                    >
                      <view class="wheel-disc-surface">
                        <view class="wheel-disc-bg" style="{{wheelBackgroundStyle}}">
                          <view class="{{item.sliceClassName}}" wx:for="{{wheelSlices}}" wx:key="id" style="{{item.style}}">
                            <view class="wheel-slice-label" style="{{item.innerStyle}}; {{item.labelStyle}}">{{item.label}}</view>
                          </view>
                        </view>
                      </view>
                    </view>

                    <button
                      class="wheel-center-button {{pageData.wheelDetail.viewerCanSpin ? 'is-actionable' : 'is-disabled'}}"
                      bindtap="handleWheelCenterTap"
                      disabled="{{!pageData.wheelDetail.viewerCanSpin || wheelSpinning}}"
                      hover-class="none"
                    >
                      <image class="wheel-center-button-image" src="../../assets/icons/pic_tools_zhuanpan_btn.png" mode="aspectFit" />
                      <view class="wheel-center-button-text wheel-center-button-text--large">开始</view>
                    </button>
                  </view>
                </view>
              </view>
            </view>
          </tool-hero-shell>

          <view class="seat-draw-more-action" wx:if="{{pageData.isAdmin}}" bindtap="handleOpenActionSheet">更多操作</view>

          <tool-result-shell
            title="{{heroView.resultTitle}}"
            showEmpty="{{!wheelVisibleHistoryLabels.length}}"
            emptyText="暂无记录"
          >
            <view class="wheel-result-list" wx:if="{{wheelVisibleHistoryLabels.length}}">
              <view class="wheel-result-item" wx:for="{{wheelVisibleHistoryLabels}}" wx:key="index">
                <text>{{index + 1}}. {{item}}</text>
              </view>
            </view>
          </tool-result-shell>
        </block>
      </block>

      <block wx:if="{{pageData.toolType === 'lottery'}}">
        <block wx:if="{{!pageData.isStarted && pageData.isAdmin && !isDraftEditing}}">
          <view class="tool-empty-wrap tool-empty-wrap--admin">
            <view class="tool-empty-copy">管理员录入答案后，使用人点击卡片翻出自己的结果。</view>
            <button class="primary-btn detail-btn seat-draw-primary-btn tool-empty-btn" bindtap="handleCreateDraft">创建玩法</button>
          </view>
        </block>

        <block wx:elif="{{!pageData.isStarted && !pageData.isAdmin}}">
          <view class="tool-empty-wrap tool-empty-wrap--viewer">
            <view class="tool-viewer-empty">暂未开放</view>
          </view>
        </block>

        <block wx:elif="{{pageData.isAdmin && isDraftEditing}}">
          <view class="tool-editor-panel">
            <view class="tool-editor-row">
              <view class="tool-editor-label">主题名称</view>
              <input
                class="tool-editor-input"
                value="{{lotteryTopicInput}}"
                maxlength="30"
                placeholder="请输入主题名称"
                placeholder-class="field-placeholder"
                bindinput="handleLotteryTopicInput"
              />
            </view>

            <view class="tool-editor-field">
              <view class="tool-editor-label">答案</view>
              <textarea
                class="tool-editor-textarea"
                value="{{lotteryAnswersInput}}"
                maxlength="500"
                placeholder="一行一个答案"
                placeholder-class="field-placeholder"
                bindinput="handleLotteryAnswersInput"
              />
              <view class="tool-editor-hint">每行对应 1 张卡片，创建后会随机打乱并固定映射。</view>
            </view>

            <view class="tool-editor-row">
              <view class="tool-editor-label">次数</view>
              <input
                class="tool-editor-input"
                type="number"
                value="{{lotteryDrawLimitInput}}"
                bindinput="handleLotteryDrawLimitInput"
              />
            </view>

            <view class="switch-row tool-editor-inline">
              <view class="switch-copy-wrap">
                <view class="switch-title tool-editor-label">指定使用人</view>
              </view>
              <switch checked="{{lotteryAllowAssignedUser}}" bindchange="handleLotteryAllowAssignedUserChange" color="#2f7cff" />
            </view>

            <view class="tool-editor-field" wx:if="{{lotteryAllowAssignedUser}}">
              <view class="tool-editor-label">指定成员</view>
              <picker range="{{lotteryEligibleUserLabels}}" value="{{lotteryAssignedUserIndex}}" bindchange="handleLotteryAssignedUserChange">
                <view class="picker-trigger tool-editor-picker">{{lotteryEligibleUserLabels[lotteryAssignedUserIndex] || '请选择使用成员'}}</view>
              </picker>
            </view>

            <button class="primary-btn detail-btn seat-draw-primary-btn tool-editor-btn" bindtap="handleLotteryPublish">{{isRecreateMode ? '重新创建' : '立即创建'}}</button>
          </view>
        </block>

        <block wx:elif="{{pageData.isStarted && pageData.lotteryDetail}}">
          <tool-hero-shell
            eyebrowText="{{heroView.eyebrowText}}"
            titleText="{{heroView.titleText}}"
            subtitleText="{{heroView.subtitleText}}"
            illustrationSrc="{{heroView.illustrationSrc}}"
            illustrationClassName="{{heroView.illustrationClassName}}"
          >
            <view>
              <view class="lottery-card-grid lottery-card-grid--hero">
                <view
                  class="lottery-card {{item.state === 'viewer' ? 'is-revealed' : ''}} {{item.state === 'claimed' ? 'is-claimed' : ''}} {{item.canClaim ? 'is-actionable' : 'is-disabled'}}"
                  wx:for="{{pageData.lotteryDetail.cards}}"
                  wx:key="id"
                  data-card-id="{{item.id}}"
                  bindtap="handleLotteryCardTap"
                >
                  <view class="lottery-card-inner">
                    <view class="lottery-card-face lottery-card-face--back">
                      <view class="lottery-card-order">{{item.order}}</view>
                      <view class="lottery-card-sign">{{item.state === 'claimed' ? '已被抽取' : '签'}}</view>
                    </view>
                    <view class="lottery-card-face lottery-card-face--front">
                      <view class="lottery-card-front-label">第 {{item.order}} 签</view>
                      <view class="lottery-card-answer">{{item.answer}}</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </tool-hero-shell>

          <view class="seat-draw-more-action" wx:if="{{pageData.isAdmin}}" bindtap="handleOpenActionSheet">更多操作</view>

          <tool-result-shell
            title="{{heroView.resultTitle}}"
            showEmpty="{{!pageData.lotteryDetail.viewerClaimRecords.length}}"
            emptyText="暂无记录"
          >
            <view class="lottery-result-list" wx:if="{{pageData.lotteryDetail.viewerClaimRecords.length}}">
              <view class="lottery-result-item" wx:for="{{pageData.lotteryDetail.viewerClaimRecords}}" wx:key="cardId">
                <view class="lottery-result-order">第 {{item.order}} 签</view>
                <view class="lottery-result-answer">{{item.answer}}</view>
              </view>
            </view>
          </tool-result-shell>
        </block>
      </block>
    </block>
  </view>

  <view class="{{showActionSheet ? 'action-sheet-mask is-visible' : 'action-sheet-mask'}}" bindtap="handleCloseActionSheet">
    <view class="{{showActionSheet ? 'action-sheet-panel is-visible' : 'action-sheet-panel'}}" catchtap="handleSheetPanelTap">
      <button class="action-sheet-btn" bindtap="handleReset">
        <view class="action-sheet-row">
          <image class="action-sheet-icon" src="/assets/icons/icon_tools_reset.svg" mode="aspectFit" />
          <view class="action-sheet-copy">
            <view class="action-sheet-title">重置</view>
            <view class="action-sheet-desc">清除所有历史结果</view>
          </view>
        </view>
      </button>
      <button class="action-sheet-btn" bindtap="handleRecreateDraft">
        <view class="action-sheet-row">
          <image class="action-sheet-icon" src="/assets/icons/icon_tools_recreat.svg" mode="aspectFit" />
          <view class="action-sheet-copy">
            <view class="action-sheet-title">重新创建</view>
            <view class="action-sheet-desc">清除所有内容</view>
          </view>
        </view>
      </button>
      <button class="action-sheet-btn action-sheet-btn--danger" bindtap="handleCloseTool">
        <view class="action-sheet-row">
          <image class="action-sheet-icon" src="/assets/icons/icon_tools_close.svg" mode="aspectFit" />
          <view class="action-sheet-copy">
            <view class="action-sheet-title">关闭玩法</view>
          </view>
        </view>
      </button>
      <button class="action-sheet-cancel" bindtap="handleCloseActionSheet">取消</button>
    </view>
  </view>
</view>
