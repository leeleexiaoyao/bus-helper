.tool-detail-page {
  min-height: 100vh;
  background: #f3f4f6;
}

.tool-detail-page--seat-draw {
  background: #f3f4f6;
}

.tool-detail-page--editor {
  background: #eef2fb;
}

.custom-nav-spacer {
  width: 100%;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  background: #f3f4f6;
  box-sizing: border-box;
}

.tool-detail-page--editor .custom-nav {
  background: #eef2fb;
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.custom-back {
  position: absolute;
  left: 0;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  transform: translateY(-50%);
}

.custom-back-icon {
  display: block;
  color: var(--text-primary);
  font-size: 52rpx;
  font-weight: 500;
  line-height: 1;
}

.custom-nav-title {
  flex: 1;
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.custom-action {
  position: absolute;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(31, 37, 57, 0.08);
  transform: translateY(-50%);
  box-sizing: border-box;
}

.custom-action-icon {
  color: var(--text-primary);
  font-size: 34rpx;
  line-height: 1;
}

.page-shell.tool-detail-content {
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.tool-detail-page--seat-draw .page-shell.tool-detail-content {
  padding-top: 18rpx;
  padding-bottom: 72rpx;
}

.tool-detail-page--editor .page-shell.tool-detail-content {
  padding-top: 18rpx;
  padding-bottom: 72rpx;
}

.play-card,
.result-card,
.action-card {
  padding: 24rpx 22rpx;
  margin-top: 16rpx;
}

.section-title,
.field-label,
.switch-title,
.mode-title,
.result-subtitle {
  font-size: 30rpx;
  font-weight: 700;
}

.result-subtitle {
  margin-top: 22rpx;
}

.play-card,
.action-card {
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.editor-block,
.play-summary {
  margin-top: 18rpx;
}

.editor-block {
  padding: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
}

.form-block {
  margin-top: 16rpx;
}

.field-input,
.wheel-input {
  margin-top: 10rpx;
  border-radius: 18rpx;
  border: 1rpx solid #f0f1f5;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
}

.field-placeholder {
  color: #d3d8e2;
}

.switch-row,
.mode-row,
.rolling-card,
.lottery-result-card,
.topic-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8f9fb;
}

.switch-row,
.mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.editor-block .switch-row,
.editor-block .mode-row {
  padding-left: 0;
  padding-right: 0;
  background: transparent;
}

.switch-copy-wrap {
  min-width: 0;
}

.mode-switches,
.play-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mode-chip,
.summary-chip,
.pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--text-secondary);
  font-size: 22rpx;
  border: 1rpx solid #ededed;
}

.mode-chip.is-active,
.pill {
  border-color: rgba(255, 83, 54, 0.16);
  background: rgba(255, 83, 54, 0.12);
  color: var(--brand);
}

.tool-detail-page--editor .mode-chip.is-active {
  border-color: rgba(47, 124, 255, 0.18);
  background: rgba(47, 124, 255, 0.12);
  color: #2f7cff;
}

.detail-btn {
  width: 100%;
}

.seat-draw-top-hint {
  width: 514rpx;
  max-width: 100%;
  margin: 0 auto 30rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #bcc2cf;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  box-sizing: border-box;
}

.seat-draw-empty-wrap {
  min-height: calc(100vh - 260rpx);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.seat-draw-empty-wrap--admin {
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.seat-draw-empty-wrap--viewer {
  justify-content: center;
}

.seat-draw-empty-copy,
.seat-draw-empty-hint {
  color: #a8afbc;
  font-size: 28rpx;
  text-align: center;
}

.seat-draw-empty-wrap--admin .seat-draw-empty-copy,
.seat-draw-empty-wrap--admin .seat-draw-empty-hint {
  margin-bottom: 0;
}

.seat-draw-empty-wrap--admin .seat-draw-primary-btn {
  width: 100%;
  max-width: 690rpx;
}

.seat-draw-empty-btn {
  width: 230rpx;
  max-width: 230rpx;
}

.seat-draw-viewer-empty {
  color: #9ea5b2;
  font-size: 28rpx;
  text-align: center;
}

.seat-draw-primary-btn {
  background: #2f7cff;
  color: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.seat-draw-disabled-btn {
  background: #cfcfcf;
  color: rgba(255, 255, 255, 0.9);
  border-radius: 18rpx;
  padding: 24rpx 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.seat-draw-editor-card,
.seat-draw-stage-panel,
.seat-draw-result-card {
  margin-top: 14rpx;
  border: none;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(148, 163, 184, 0.06);
}

.seat-draw-editor-card {
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.seat-draw-editor-row {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
}

.seat-draw-editor-row:first-child {
  margin-top: 0;
}

.seat-draw-editor-label {
  color: #30343f;
  font-size: 26rpx;
  font-weight: 600;
}

.seat-draw-editor-input,
.seat-draw-editor-select {
  min-height: 84rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f5;
  box-sizing: border-box;
}

.seat-draw-editor-input {
  width: 100%;
  color: #4b5563;
  font-size: 26rpx;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
}

.seat-draw-editor-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
}

.seat-draw-editor-select-text {
  color: #d3d8e2;
  font-size: 26rpx;
}

.seat-draw-editor-select-arrow {
  color: #c7ccd7;
  font-size: 28rpx;
  line-height: 1;
}

.seat-draw-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.seat-draw-switch-text {
  color: #30343f;
  font-size: 26rpx;
  font-weight: 500;
}

.seat-draw-editor-btn {
  margin-top: 24rpx;
}

.seat-draw-stage-panel {
  padding: 22rpx 20rpx 20rpx;
}

.seat-draw-stage-topic {
  color: #1f2430;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.seat-draw-stage-meta {
  margin-top: 8rpx;
  color: #a0a7b4;
  font-size: 24rpx;
  line-height: 1.4;
}

.seat-draw-slots-wrap {
  display: flex;
  justify-content: center;
  margin-top: 26rpx;
}

.seat-draw-slots {
  display: inline-flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  padding: 0;
}

.seat-draw-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e4e8f0;
  background: #f1f3f7;
  box-sizing: border-box;
}

.seat-draw-slot-text {
  color: #ff4c4c;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1;
}

.seat-draw-slot-text--placeholder {
  color: #ffb322;
  font-size: 48rpx;
}

.seat-draw-panel-btn {
  margin-top: 50rpx;
}

.seat-draw-panel-btn--secondary {
  margin-top: 12rpx;
}

.seat-draw-stage-tip {
  margin-top: 22rpx;
  color: #9aa1af;
  font-size: 26rpx;
  text-align: center;
}

.seat-draw-stage-tip--ended {
  color: #4b5563;
}

.seat-draw-result-card {
  padding: 18rpx 20rpx 20rpx;
}

.seat-draw-result-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #9ba3b0;
  font-size: 28rpx;
  line-height: 1.6;
}

.seat-draw-result-index {
  flex-shrink: 0;
}

.seat-draw-result-value {
  flex: 1;
  min-width: 0;
}

.seat-draw-more-action {
  margin-top: 18rpx;
  color: #9ba3b0;
  font-size: 24rpx;
  text-align: center;
}

.tool-top-hint {
  width: 514rpx;
  max-width: 100%;
  margin: 0 auto 30rpx;
  padding: 12rpx 20rpx;
  color: #bcc2cf;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  box-sizing: border-box;
}

.tool-empty-wrap {
  min-height: calc(100vh - 260rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.tool-empty-wrap--admin {
  align-items: center;
  gap: 18rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.tool-empty-wrap--viewer {
  justify-content: center;
}

.tool-empty-copy,
.tool-viewer-empty {
  color: #a8afbc;
  font-size: 28rpx;
  text-align: center;
}

.tool-empty-btn {
  width: 230rpx;
  max-width: 230rpx;
}

.tool-editor-panel {
  margin-top: 12rpx;
}

.tool-editor-row {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
}

.tool-editor-row:first-child,
.tool-editor-field:first-child {
  margin-top: 0;
}

.tool-editor-field {
  margin-top: 16rpx;
}

.tool-editor-label {
  color: #30343f;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-editor-input,
.tool-editor-textarea {
  width: 100%;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f5;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
  box-sizing: border-box;
}

.tool-editor-input {
  min-height: 84rpx;
  padding: 0 22rpx;
  color: #4b5563;
  font-size: 26rpx;
}

.tool-editor-textarea {
  min-height: 220rpx;
  margin-top: 12rpx;
  padding: 24rpx;
  font-size: 26rpx;
}

.tool-editor-picker {
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f5;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
  color: #4b5563;
  font-size: 26rpx;
  line-height: 84rpx;
  box-sizing: border-box;
}

.tool-editor-inline {
  margin-top: 20rpx;
  padding-left: 0;
  padding-right: 0;
  background: transparent;
}

.tool-editor-hint {
  margin-top: 12rpx;
  color: #9aa1af;
  font-size: 22rpx;
  line-height: 1.6;
}

.tool-editor-btn {
  margin-top: 26rpx;
}

.rolling-label,
.result-empty,
.wheel-result,
.lottery-result-text {
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 1.6;
}

.vote-progress {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.rolling-value {
  margin-top: 10rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.lottery-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 18rpx;
}

.lottery-card-panel {
  margin-top: 16rpx;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

.lottery-card {
  perspective: 1200rpx;
}

.lottery-card-inner {
  position: relative;
  height: 220rpx;
  transform-style: preserve-3d;
  transition: transform 360ms ease;
}

.lottery-card.is-revealed .lottery-card-inner {
  transform: rotateY(180deg);
}

.lottery-card-face {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 24rpx;
  backface-visibility: hidden;
  box-sizing: border-box;
}

.lottery-card-face--back {
  border: 1rpx solid rgba(47, 124, 255, 0.08);
  background: linear-gradient(180deg, #ffffff 0%, #f4f8ff 100%);
  box-shadow: 0 12rpx 28rpx rgba(47, 124, 255, 0.08);
}

.lottery-card-face--front {
  padding: 24rpx;
  border: 1rpx solid rgba(255, 140, 66, 0.1);
  background: linear-gradient(180deg, #fffaf2 0%, #fff1dc 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 154, 90, 0.12);
  transform: rotateY(180deg);
}

.lottery-card.is-actionable .lottery-card-face--back {
  border-color: rgba(47, 124, 255, 0.2);
  box-shadow: 0 16rpx 34rpx rgba(47, 124, 255, 0.14);
}

.lottery-card.is-disabled {
  opacity: 0.92;
}

.lottery-card.is-claimed .lottery-card-face--back {
  background: linear-gradient(180deg, #f7f8fa 0%, #eef1f5 100%);
  box-shadow: none;
}

.lottery-card-order {
  color: #2f7cff;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.lottery-card-sign {
  margin-top: 20rpx;
  color: #7f8ba3;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
}

.lottery-card-front-label {
  color: #bb7a1f;
  font-size: 24rpx;
  font-weight: 600;
}

.lottery-card-answer {
  margin-top: 16rpx;
  color: #2f3441;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.5;
  word-break: break-word;
}

.lottery-result-empty {
  margin-top: 18rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 1.6;
}

.lottery-result-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.lottery-result-item {
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8f9fb;
}

.lottery-result-order {
  color: #8a93a5;
  font-size: 22rpx;
}

.lottery-result-answer {
  margin-top: 10rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.topic-card {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.6;
}

.vote-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.vote-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.vote-option-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e8ebef;
  background: #ffffff;
}

.vote-option-card.is-selected {
  border-color: rgba(255, 83, 54, 0.18);
  background: rgba(255, 83, 54, 0.08);
}

.vote-option-label {
  font-size: 26rpx;
  font-weight: 600;
}

.vote-option-count {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.vote-final-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.vote-final-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8f9fb;
}

.vote-final-label {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.vote-final-count {
  color: var(--text-secondary);
  font-size: 24rpx;
  white-space: nowrap;
}

.vote-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.vote-stat {
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #f8f9fb;
  text-align: center;
}

.vote-count {
  font-size: 32rpx;
  font-weight: 700;
}

.vote-label {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.vote-choice-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
}

.vote-end-btn {
  width: 100%;
  margin-bottom: 20rpx;
}

.vote-choice-btn {
  width: 100%;
  padding: 22rpx 10rpx;
  font-size: 24rpx;
}

.wheel-input {
  width: 100%;
  min-height: 220rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  font-size: 26rpx;
  box-sizing: border-box;
}

.wheel-editor-card {
  padding: 24rpx 22rpx;
}

.wheel-editor-field {
  margin-top: 22rpx;
}

.wheel-editor-hint {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.wheel-stage {
  position: relative;
  margin-top: 12rpx;
  padding-top: 24rpx;
}

.wheel-shell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.wheel-focus-beam {
  position: absolute;
  top: 18rpx;
  left: 50%;
  width: 0;
  height: 0;
  border-left: 118rpx solid transparent;
  border-right: 118rpx solid transparent;
  border-bottom: 218rpx solid rgba(255, 204, 175, 0.36);
  filter: blur(2rpx);
  transform: translateX(-50%);
  z-index: 1;
}

.wheel-pointer {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40rpx;
  height: 54rpx;
  transform: translate(-50%, -112rpx);
  z-index: 5;
}

.wheel-pointer-arrow {
  position: absolute;
  left: 50%;
  top: 0;
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 54rpx solid #ff6230;
  filter: drop-shadow(0 6rpx 10rpx rgba(255, 93, 53, 0.24));
  transform: translateX(-50%);
}

.wheel-frame {
  position: relative;
  width: 620rpx;
  height: 620rpx;
}

.wheel-disc {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  margin: 50rpx;
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.18, 0.88, 0.2, 1);
  z-index: 3;
}

.wheel-light-track {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(255, 250, 240, 0) 70%, rgba(255, 90, 47, 0.06) 100%);
  z-index: 1;
}

.wheel-light {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #ffffff 0%, #fffaf2 28%, #ffd98f 62%, #ff9d49 100%);
  box-shadow: 0 0 16rpx rgba(255, 226, 143, 0.95);
  animation: wheelLightPulse 1.8s ease-in-out infinite;
}

.wheel-disc-outer,
.wheel-disc-middle,
.wheel-disc-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.wheel-disc-outer {
  background: linear-gradient(180deg, #fff5df 0%, #ffd98c 100%);
  box-shadow: 0 20rpx 40rpx rgba(255, 119, 73, 0.22);
}

.wheel-disc-middle {
  inset: 14rpx;
  background: linear-gradient(180deg, #ff6b43 0%, #ff4029 100%);
}

.wheel-disc-bg {
  inset: 34rpx;
  overflow: hidden;
  box-shadow:
    inset 0 0 0 8rpx rgba(255, 245, 214, 0.95),
    inset 0 24rpx 44rpx rgba(255, 255, 255, 0.28);
}

.wheel-slice {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 176rpx;
  text-align: center;
}

.wheel-slice.is-tight {
  width: 150rpx;
}

.wheel-divider {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 4rpx;
  height: 214rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 240, 211, 0.98) 0%, rgba(255, 224, 171, 0.9) 100%);
  box-shadow: 0 0 10rpx rgba(255, 236, 200, 0.72);
  transform-origin: center bottom;
  z-index: 1;
}

.wheel-slice-label {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  color: #d45518;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
  text-shadow: 0 2rpx 8rpx rgba(255, 245, 225, 0.8);
}

.wheel-slice.is-tight .wheel-slice-label {
  font-size: 21rpx;
}

.wheel-empty-wrap {
  margin-top: 20rpx;
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(31, 37, 57, 0.06);
}

.wheel-empty-wrap--viewer {
  text-align: center;
}

.wheel-empty-copy {
  color: #9a6a56;
  font-size: 26rpx;
  line-height: 1.7;
}

.wheel-empty-wrap .detail-btn {
  margin-top: 24rpx;
}

.wheel-center-button {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 172rpx;
  height: 172rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ff7b5d 0%, #ff3d2e 100%);
  box-shadow:
    inset 0 8rpx 18rpx rgba(255, 223, 174, 0.34),
    0 16rpx 28rpx rgba(255, 84, 53, 0.22);
  transform: translate(-50%, -50%);
  z-index: 6;
}

.wheel-center-button.is-actionable {
  transform: translate(-50%, -50%) scale(1);
}

.wheel-center-button.is-disabled {
  opacity: 0.72;
}

.wheel-center-button.is-busy {
  animation: wheelCenterPulse 0.9s ease-in-out infinite;
}

.wheel-center-button-ring {
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 240, 197, 0.92);
  box-shadow: inset 0 6rpx 10rpx rgba(255, 250, 233, 0.3);
}

.wheel-center-button-text {
  position: relative;
  color: #fff6dc;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.1;
  text-shadow: 0 4rpx 10rpx rgba(155, 39, 0, 0.22);
}

.wheel-center-button-text--large {
  font-size: 46rpx;
  letter-spacing: 2rpx;
}

.wheel-result-empty {
  margin-top: 18rpx;
  color: #9a6a56;
  font-size: 28rpx;
}

.wheel-result-list {
  margin-top: 16rpx;
  padding-left: 0;
}

.wheel-result-hero {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fff7eb 0%, #ffe6d6 100%);
  border: 2rpx solid rgba(255, 216, 167, 0.8);
  box-shadow: 0 12rpx 28rpx rgba(255, 152, 102, 0.1);
  text-align: center;
}

.wheel-result-hero-label {
  color: #c06b3d;
  font-size: 22rpx;
  font-weight: 700;
}

.wheel-result-hero-value {
  margin-top: 10rpx;
  color: #e25621;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.result-card {
  padding: 24rpx;
  margin-top: 16rpx;
}

.wheel-result-item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 1.8;
  white-space: normal;
}

@keyframes wheelLightPulse {
  0%,
  100% {
    opacity: 0.7;
    box-shadow: 0 0 16rpx rgba(255, 226, 143, 0.95);
  }

  50% {
    opacity: 1;
    box-shadow: 0 0 26rpx rgba(255, 241, 196, 1);
  }
}

@keyframes wheelCenterPulse {
  0%,
  100% {
    transform: translate(-50%, -50%) scale(1);
  }

  50% {
    transform: translate(-50%, -50%) scale(1.04);
  }
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f8f9fb;
}

.member-row--spread {
  align-items: flex-start;
}

.member-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  background: #dfe4ec;
  color: transparent;
  font-size: 0;
  box-shadow: inset 0 0 0 1rpx rgba(117, 122, 134, 0.08);
  flex-shrink: 0;
}

.member-avatar::before {
  content: "";
  position: absolute;
  top: 22%;
  left: 50%;
  width: 32%;
  height: 32%;
  border-radius: 50%;
  background: #bcc4d0;
  transform: translateX(-50%);
}

.member-avatar::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 15%;
  width: 56%;
  height: 28%;
  border-radius: 999rpx 999rpx 22rpx 22rpx;
  background: #bcc4d0;
  transform: translateX(-50%);
}

.member-name {
  font-size: 27rpx;
  font-weight: 600;
}

.member-self {
  margin-left: 10rpx;
  color: var(--brand);
  font-size: 22rpx;
}

.member-seat {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.history-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.history-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f5f6;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.lottery-status {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eef1f3;
  color: var(--text-secondary);
  font-size: 22rpx;
  flex-shrink: 0;
}

.lottery-status.is-hit {
  background: rgba(33, 201, 128, 0.14);
  color: var(--success);
}

.lottery-status.is-miss {
  background: rgba(211, 79, 61, 0.1);
  color: var(--danger);
}

.action-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.26);
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease;
}

.action-sheet-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.action-sheet-panel {
  width: 100%;
  padding: 0 0 calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 220ms ease;
}

.action-sheet-panel.is-visible {
  transform: translateY(0);
}

.action-sheet-btn,
.action-sheet-cancel {
  width: 100%;
  margin-top: 0;
  padding: 28rpx 32rpx;
  border-radius: 0;
  background: transparent;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 400;
  border: none;
  border-top: 1rpx solid #eceff3;
}

.action-sheet-btn {
  display: block;
}

.action-sheet-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.action-sheet-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: #606772;
  font-size: 24rpx;
  line-height: 1;
  flex-shrink: 0;
}

.action-sheet-copy {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
}

.action-sheet-title {
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.4;
}

.action-sheet-desc {
  color: #9aa1af;
  font-size: 22rpx;
  line-height: 1.4;
}

.action-sheet-btn--danger {
  color: var(--danger);
}

.action-sheet-btn--danger .action-sheet-icon,
.action-sheet-btn--danger .action-sheet-title {
  color: var(--danger);
}

.action-sheet-btn:first-child {
  border-top: none;
}

.action-sheet-cancel {
  margin-top: 10rpx;
  min-height: 88rpx;
  background: #f1f1f1;
  color: #5b616d;
  font-size: 28rpx;
}
