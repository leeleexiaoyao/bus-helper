  line-height: 1.7;
}

.wheel-empty-wrap .detail-btn {
  margin-top: 24rpx;
}

.wheel-center-button {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 228rpx;
  height: 228rpx;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
  transform: translate(-50%, -50%);
  z-index: 8;
}

.wheel-center-button::after {
  border: none;
}

.wheel-center-button.is-actionable {
  transform: translate(-50%, -50%) scale(1);
}

.wheel-center-button.is-disabled {
  opacity: 0.72;
}

.wheel-center-button-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.wheel-center-button-text {
  position: relative;
  z-index: 1;
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
