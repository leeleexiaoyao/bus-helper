}

@keyframes wheelLightPulse {
  0%,
  100% {
    opacity: 0.7;
    box-shadow: 0 0 16rpx rgba(255, 226, 143, 0.95);
  }

  50% {
    opacity: 1;
    box-shadow: 0 0 26rpx rgba(255, 241, 196, 1);
  }
}

@keyframes wheelCenterPulse {
  0%,
  100% {
    transform: translate(-50%, -50%) scale(1);
  }

  50% {
    transform: translate(-50%, -50%) scale(1.04);
  }
}

