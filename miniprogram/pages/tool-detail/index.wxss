.tool-detail-page {
  min-height: 100vh;
  background: #eceff7;
}

.tool-detail-page--seat-draw {
  background: #eceff7;
}

.tool-detail-page--editor {
  background: #eef2fb;
}

.custom-nav-spacer {
  width: 100%;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  background: #eceff7;
  box-sizing: border-box;
}

.tool-detail-page--editor .custom-nav {
  background: #eef2fb;
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.custom-back {
  position: absolute;
  left: 0;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  transform: translateY(-50%);
}

.custom-back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #111111;
  border-bottom: 4rpx solid #111111;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.custom-nav-title {
  flex: 1;
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.custom-action {
  position: absolute;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(31, 37, 57, 0.08);
  transform: translateY(-50%);
  box-sizing: border-box;
}

.custom-action-icon {
  color: var(--text-primary);
  font-size: 34rpx;
  line-height: 1;
}

.page-shell.tool-detail-content {
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.tool-detail-page--seat-draw .page-shell.tool-detail-content {
  padding-top: 18rpx;
  padding-bottom: 72rpx;
}

.tool-detail-page--editor .page-shell.tool-detail-content {
  padding-top: 18rpx;
  padding-bottom: 72rpx;
}

.play-card,
.result-card,
.action-card {
  padding: 24rpx 22rpx;
  margin-top: 16rpx;
}

.section-title,
.field-label,
.switch-title,
.mode-title,
.result-subtitle {
  font-size: 30rpx;
  font-weight: 700;
}

.result-subtitle {
  margin-top: 22rpx;
}

.play-card,
.action-card {
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.editor-block,
.play-summary {
  margin-top: 18rpx;
}

.editor-block {
  padding: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
}

.form-block {
  margin-top: 16rpx;
}

.field-input,
.wheel-input {
  margin-top: 10rpx;
  border-radius: 18rpx;
  border: 1rpx solid #f0f1f5;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
}

.field-placeholder {
  color: #d3d8e2;
}

.switch-row,
.mode-row,
.rolling-card,
.lottery-result-card,
.topic-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8f9fb;
}

.switch-row,
.mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.editor-block .switch-row,
.editor-block .mode-row {
  padding-left: 0;
  padding-right: 0;
  background: transparent;
}

.switch-copy-wrap {
  min-width: 0;
}

.mode-switches,
.play-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mode-chip,
.summary-chip,
.pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--text-secondary);
  font-size: 22rpx;
  border: 1rpx solid #ededed;
}

.mode-chip.is-active,
.pill {
  border-color: rgba(255, 83, 54, 0.16);
  background: rgba(255, 83, 54, 0.12);
  color: var(--brand);
}

.tool-detail-page--editor .mode-chip.is-active {
  border-color: rgba(47, 124, 255, 0.18);
  background: rgba(47, 124, 255, 0.12);
  color: #2f7cff;
}

.detail-btn {
  width: 100%;
}

.seat-draw-top-hint {
  width: 514rpx;
  max-width: 100%;
  margin: 0 auto 30rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #bcc2cf;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  box-sizing: border-box;
}

.seat-draw-empty-wrap {
  min-height: calc(100vh - 260rpx);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.seat-draw-empty-wrap--admin {
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.seat-draw-empty-wrap--viewer {
  justify-content: center;
}

.seat-draw-empty-copy,
.seat-draw-empty-hint {
  color: #a8afbc;
  font-size: 28rpx;
  text-align: center;
}

.seat-draw-empty-wrap--admin .seat-draw-empty-copy,
.seat-draw-empty-wrap--admin .seat-draw-empty-hint {
  margin-bottom: 0;
}

.seat-draw-empty-wrap--admin .seat-draw-primary-btn {
  width: 100%;
  max-width: 690rpx;
}

.seat-draw-empty-btn {
  width: 230rpx;
  max-width: 230rpx;
}

.seat-draw-viewer-empty {
  color: #9ea5b2;
  font-size: 28rpx;
  text-align: center;
}

.seat-draw-primary-btn {
  background: #2f7cff;
  color: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.seat-draw-disabled-btn {
  background: #cfcfcf;
  color: rgba(255, 255, 255, 0.9);
  border-radius: 18rpx;
  padding: 24rpx 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.seat-draw-editor-card,
.seat-draw-stage-panel,
.seat-draw-result-card {
  margin-top: 14rpx;
  border: none;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(148, 163, 184, 0.06);
}

.seat-draw-editor-card {
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.seat-draw-editor-row {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
}

.seat-draw-editor-row:first-child {
  margin-top: 0;
}

.seat-draw-editor-label {
  color: #30343f;
  font-size: 26rpx;
  font-weight: 600;
}

.seat-draw-editor-input,
.seat-draw-editor-select {
  min-height: 84rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f5;
  box-sizing: border-box;
}

.seat-draw-editor-input {
  width: 100%;
  color: #4b5563;
  font-size: 26rpx;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
}

.seat-draw-editor-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
}

.seat-draw-editor-select-text {
  color: #d3d8e2;
  font-size: 26rpx;
}

.seat-draw-editor-select-arrow {
  color: #c7ccd7;
  font-size: 28rpx;
  line-height: 1;
}

.seat-draw-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.seat-draw-switch-text {
  color: #30343f;
  font-size: 26rpx;
  font-weight: 500;
}

.seat-draw-editor-btn {
  margin-top: 24rpx;
}

.seat-draw-stage-panel {
  padding: 22rpx 20rpx 20rpx;
}

.seat-draw-stage-topic {
  color: #1f2430;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.seat-draw-stage-meta {
  margin-top: 8rpx;
  color: #a0a7b4;
  font-size: 24rpx;
  line-height: 1.4;
}

.seat-draw-slots-wrap {
  display: flex;
  justify-content: center;
  margin-top: 26rpx;
}

.seat-draw-slots {
  display: inline-flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  padding: 0;
}

.seat-draw-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e4e8f0;
  background: #f1f3f7;
  box-sizing: border-box;
}

.seat-draw-slot-text {
  color: #ff4c4c;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1;
}

.seat-draw-slot-text--placeholder {
  color: #ffb322;
  font-size: 48rpx;
}

.seat-draw-panel-btn {
  margin-top: 50rpx;
}

.seat-draw-panel-btn--secondary {
  margin-top: 12rpx;
}

.seat-draw-stage-tip {
  margin-top: 22rpx;
  color: #9aa1af;
  font-size: 26rpx;
  text-align: center;
}

.seat-draw-stage-tip--ended {
  color: #4b5563;
}

.seat-draw-result-card {
  padding: 18rpx 20rpx 20rpx;
}

.seat-draw-result-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #9ba3b0;
  font-size: 28rpx;
  line-height: 1.6;
}

.seat-draw-result-index {
  flex-shrink: 0;
}

.seat-draw-result-value {
  flex: 1;
  min-width: 0;
}

.seat-draw-more-action {
  margin-top: 18rpx;
  color: #9ba3b0;
  font-size: 24rpx;
  text-align: center;
}

.tool-top-hint {
  width: 514rpx;
  max-width: 100%;
  margin: 0 auto 30rpx;
  padding: 12rpx 20rpx;
  color: #bcc2cf;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  box-sizing: border-box;
}

.tool-empty-wrap {
  min-height: calc(100vh - 260rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.tool-empty-wrap--admin {
  align-items: center;
  gap: 18rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.tool-empty-wrap--viewer {
  justify-content: center;
}

.tool-empty-copy,
.tool-viewer-empty {
  color: #a8afbc;
  font-size: 28rpx;
  text-align: center;
}

.tool-empty-btn {
  width: 230rpx;
  max-width: 230rpx;
}

.tool-editor-panel {
  margin-top: 12rpx;
}

.tool-editor-row {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
}

.tool-editor-row:first-child,
.tool-editor-field:first-child {
  margin-top: 0;
}

.tool-editor-field {
  margin-top: 16rpx;
}

.tool-editor-label {
  color: #30343f;
  font-size: 26rpx;
  font-weight: 600;
}

.tool-editor-input,
.tool-editor-textarea {
  width: 100%;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f5;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
  box-sizing: border-box;
}

.tool-editor-input {
  min-height: 84rpx;
  padding: 0 22rpx;
  color: #4b5563;
  font-size: 26rpx;
}

.tool-editor-textarea {
  min-height: 220rpx;
  margin-top: 12rpx;
  padding: 24rpx;
  font-size: 26rpx;
}

.tool-editor-picker {
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f5;
  box-shadow: inset 0 0 0 1rpx rgba(240, 241, 245, 0.45);
  color: #4b5563;
  font-size: 26rpx;
  line-height: 84rpx;
  box-sizing: border-box;
}

.tool-editor-inline {
  margin-top: 20rpx;
  padding-left: 0;
  padding-right: 0;
  background: transparent;
}

.tool-editor-hint {
  margin-top: 12rpx;
  color: #9aa1af;
  font-size: 22rpx;
  line-height: 1.6;
}

.tool-editor-btn {
  margin-top: 26rpx;
}

.tool-detail-page--editor {
  background: #f4f4f3;
}

.tool-detail-page--editor .custom-nav {
  background: #f4f4f3;
}

.tool-detail-page--editor .page-shell.tool-detail-content {
  padding: 18rpx 32rpx 72rpx;
}

.tool-detail-page--editor .seat-draw-editor-card,
.tool-detail-page--editor .tool-editor-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 0;
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.tool-detail-page--editor .seat-draw-editor-row,
.tool-detail-page--editor .tool-editor-row,
.tool-detail-page--editor .tool-editor-field,
.tool-detail-page--editor .seat-draw-switch-row,
.tool-detail-page--editor .tool-editor-inline {
  margin-top: 0;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.tool-detail-page--editor .seat-draw-editor-row,
.tool-detail-page--editor .tool-editor-row,
.tool-detail-page--editor .seat-draw-switch-row,
.tool-detail-page--editor .tool-editor-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 128rpx;
  gap: 24rpx;
}

.tool-detail-page--editor .tool-editor-field {
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.tool-detail-page--editor .seat-draw-editor-label,
.tool-detail-page--editor .tool-editor-label,
.tool-detail-page--editor .switch-title,
.tool-detail-page--editor .mode-title,
.tool-detail-page--editor .seat-draw-switch-text {
  flex: 0 0 auto;
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
}

.tool-detail-page--editor .seat-draw-editor-input,
.tool-detail-page--editor .seat-draw-editor-select,
.tool-detail-page--editor .tool-editor-input,
.tool-detail-page--editor .tool-editor-picker {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  margin-top: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: #20252b;
  font-size: 28rpx;
  font-weight: 500;
  text-align: right;
}

.tool-detail-page--editor .seat-draw-editor-select {
  justify-content: flex-end;
  gap: 12rpx;
}

.tool-detail-page--editor .seat-draw-editor-select-text,
.tool-detail-page--editor .seat-draw-editor-select-arrow,
.tool-detail-page--editor .tool-editor-picker {
  color: #9f9f9f;
  font-size: 28rpx;
}

.tool-detail-page--editor .tool-editor-textarea {
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #eef1f5;
  border-radius: 20rpx;
  background: #fbfbfb;
  box-shadow: none;
  color: #20252b;
  font-size: 28rpx;
  line-height: 1.55;
}

.tool-detail-page--editor .tool-editor-hint {
  margin-top: 12rpx;
  color: #9f9f9f;
  font-size: 24rpx;
}

.tool-detail-page--editor .mode-switches {
  justify-content: flex-end;
}

.tool-detail-page--editor .mode-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f4f4f3;
  color: #7a8290;
  font-size: 24rpx;
}

.tool-detail-page--editor .mode-chip.is-active {
  border-color: #d8e95f;
  background: #f4ffd7;
  color: #111111;
}

.tool-detail-page--editor .seat-draw-primary-btn,
.tool-detail-page--editor .tool-editor-btn,
.tool-detail-page--editor .seat-draw-editor-btn {
  min-height: 88rpx;
  margin-top: 36rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #d8f940;
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.rolling-label,
.result-empty,
.wheel-result,
.lottery-result-text {
  color: #9aa1af;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.6;
  text-align: center;
}

.vote-progress {
  color: #9ea5b1;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: right;
}

.rolling-value {
  margin-top: 10rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.lottery-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 18rpx;
}

.lottery-card-panel {
  margin-top: 16rpx;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

.lottery-card {
  perspective: 1200rpx;
}

.lottery-card-inner {
  position: relative;
  height: 220rpx;
  transform-style: preserve-3d;
  transition: transform 360ms ease;
}

.lottery-card.is-revealed .lottery-card-inner {
  transform: rotateY(180deg);
}

.lottery-card-face {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 24rpx;
  backface-visibility: hidden;
  box-sizing: border-box;
}

.lottery-card-face--back {
  border: 1rpx solid rgba(47, 124, 255, 0.08);
  background: linear-gradient(180deg, #ffffff 0%, #f4f8ff 100%);
  box-shadow: 0 12rpx 28rpx rgba(47, 124, 255, 0.08);
}

.lottery-card-face--front {
  padding: 24rpx;
  border: 1rpx solid rgba(255, 140, 66, 0.1);
  background: linear-gradient(180deg, #fffaf2 0%, #fff1dc 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 154, 90, 0.12);
  transform: rotateY(180deg);
}

.lottery-card.is-actionable .lottery-card-face--back {
  border-color: rgba(47, 124, 255, 0.2);
  box-shadow: 0 16rpx 34rpx rgba(47, 124, 255, 0.14);
}

.lottery-card.is-disabled {
  opacity: 0.92;
}

.lottery-card.is-claimed .lottery-card-face--back {
  background: linear-gradient(180deg, #f7f8fa 0%, #eef1f5 100%);
  box-shadow: none;
}

.lottery-card-order {
  color: #2f7cff;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.lottery-card-sign {
  margin-top: 20rpx;
  color: #7f8ba3;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
}

.lottery-card-front-label {
  color: #bb7a1f;
  font-size: 24rpx;
  font-weight: 600;
}

.lottery-card-answer {
  margin-top: 16rpx;
  color: #2f3441;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.5;
  word-break: break-word;
}

.lottery-result-empty {
  margin-top: 18rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 1.6;
}

.lottery-result-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.lottery-result-item {
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8f9fb;
}

.lottery-result-order {
  color: #8a93a5;
  font-size: 22rpx;
}

.lottery-result-answer {
  margin-top: 10rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.topic-card {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.6;
}

.vote-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.vote-meta-row--progress {
  justify-content: flex-end;
}

.vote-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.vote-option-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e8ebef;
  background: #ffffff;
}

.vote-option-card.is-selected {
  border-color: #c4ef27;
  background: rgba(244, 255, 215, 0.52);
}

.vote-option-copy {
  flex: 1;
  min-width: 0;
}

.vote-option-title {
  color: #6f7480;
  font-size: 22rpx;
  line-height: 1.4;
}

.vote-option-label {
  margin-top: 12rpx;
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

