  color: #1c1f24;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
  word-break: break-all;
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.58);
}

