<view class="create-trip-page">
  <view class="custom-nav-spacer" style="height: {{navTotalHeight}}px;"></view>

  <view class="custom-nav" style="height: {{navTotalHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav-inner" style="height: {{navHeight}}px; padding-right: {{navRightPadding}}px;">
      <view class="custom-back" bindtap="handleBack">
        <view class="custom-back-icon"></view>
      </view>
      <view class="custom-nav-title">创建车次</view>
    </view>
  </view>

  <view class="page-shell create-trip-content">
    <view class="form-block">
      <view class="field-label">车次名称（必填）</view>
      <input
        class="field-input"
        data-field="tripName"
        value="{{tripName}}"
        maxlength="24"
        placeholder="请输入车次名称"
        placeholder-class="field-placeholder"
        bindinput="handleInput"
      />
    </view>

    <view class="form-block">
      <view class="field-label">车次口令（必填）</view>
      <input
        class="field-input"
        data-field="password"
        value="{{password}}"
        maxlength="6"
        type="number"
        placeholder="请输入 6 位数字口令"
        placeholder-class="field-placeholder"
        bindinput="handleInput"
      />
    </view>

    <view class="form-block">
      <view class="field-label">座位模板</view>
      <view class="template-list">
        <view
          class="{{item.className}}"
          wx:for="{{templates}}"
          wx:key="id"
          data-template-id="{{item.id}}"
          bindtap="handleTemplateSelect"
        >
          <view class="template-main">
            <view class="template-name">{{item.displayName}}</view>
            <view class="template-text">{{item.layoutText}}</view>
          </view>
          <view class="template-check"></view>
        </view>
      </view>
    </view>

    <button class="primary-btn submit-btn" loading="{{submitting}}" bindtap="handleSubmit">
      立即创建
    </button>
  </view>
</view>
