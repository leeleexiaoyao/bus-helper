<view class="page-shell profile-settings-page" wx:if="{{pageData}}">
  <view class="settings-card">
    <view class="settings-page-title">首页标题</view>
    <view class="settings-page-copy">当前全局标题会同时展示在 1车 和 2车 首页顶部。</view>

    <block wx:if="{{pageData.canEditHomeTitle}}">
      <view class="settings-meta">当前身份：{{pageData.currentTripLabel}}{{pageData.viewerRoleLabel}}</view>
      <input
        class="settings-input"
        value="{{draftHomeTitle}}"
        maxlength="20"
        placeholder="请输入首页标题"
        placeholder-class="settings-input-placeholder"
        bindinput="handleTitleInput"
      />
      <button
        class="primary-btn settings-save-btn"
        loading="{{isSaving}}"
        disabled="{{isSaving}}"
        bindtap="handleSaveTitle"
      >
        {{isSaving ? '保存中...' : '保存标题'}}
      </button>
    </block>

    <block wx:else>
      <view class="settings-value-card">
        <view class="settings-value-label">当前标题</view>
        <view class="settings-value-text">{{pageData.homeTitle}}</view>
      </view>
      <view class="settings-readonly-tip">当前身份为 {{pageData.currentTripLabel}}{{pageData.viewerRoleLabel}}，可查看配置内容。</view>
    </block>
  </view>
</view>
