.profile-settings-page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: #f4f4f3;
  box-sizing: border-box;
}

.settings-card {
  border-radius: 32rpx;
  background: #ffffff;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
}

.settings-page-title {
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.settings-page-copy {
  margin-top: 18rpx;
  color: #6f7783;
  font-size: 26rpx;
  line-height: 1.7;
}

.settings-meta {
  margin-top: 24rpx;
  color: #8c9199;
  font-size: 24rpx;
  line-height: 1.4;
}

.settings-input {
  margin-top: 20rpx;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #f6f7f9;
  color: #111111;
  font-size: 30rpx;
  box-sizing: border-box;
}

.settings-input-placeholder {
  color: #b6bac1;
}

.settings-save-btn {
  margin-top: 24rpx;
  width: 100%;
}

.settings-value-card {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #f6f7f9;
}

.settings-value-label {
  color: #8c9199;
  font-size: 24rpx;
  line-height: 1.3;
}

.settings-value-text {
  margin-top: 12rpx;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.settings-readonly-tip {
  margin-top: 20rpx;
  color: #6f7783;
  font-size: 24rpx;
  line-height: 1.7;
}
