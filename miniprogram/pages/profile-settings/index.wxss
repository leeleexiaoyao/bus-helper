.profile-settings-page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: #f4f4f3;
  box-sizing: border-box;
}

.settings-about-card,
.settings-action-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.settings-about-card {
  padding: 34rpx 30rpx;
}

.settings-page-title {
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.settings-page-copy {
  margin-top: 18rpx;
  color: #6f7783;
  font-size: 26rpx;
  line-height: 1.7;
}

.settings-action-card {
  margin-top: 24rpx;
  padding: 24rpx;
}

.settings-trip-action {
  width: 100%;
  margin: 0;
}
