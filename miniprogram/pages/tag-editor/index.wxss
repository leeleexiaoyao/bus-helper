.tag-editor-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 132rpx);
  box-sizing: border-box;
  background: #f3f3f3;
}

picker {
  display: block;
}

.tag-editor-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.editor-section-title {
  margin-bottom: 16rpx;
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.editor-card {
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
}

.editor-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.editor-row--avatar {
  min-height: 136rpx;
}

.editor-row-label {
  color: #111111;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.4;
}

.editor-row-main {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  width: 430rpx;
  min-width: 430rpx;
  flex: 0 0 430rpx;
  margin-left: 24rpx;
}

.editor-row-main--avatar {
  gap: 12rpx;
}

.editor-row-value-wrap {
  width: 392rpx;
  max-width: 392rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.editor-row-value-wrap--raised {
  margin-top: -8rpx;
}

.editor-row-value {
  width: 100%;
  color: #111111;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.editor-row-value--muted,
.editor-row-value--placeholder {
  color: #c2c2c2;
}

.editor-row-caret {
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid rgba(17, 17, 17, 0.36);
  border-right: 2rpx solid rgba(17, 17, 17, 0.36);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.editor-divider {
  height: 1rpx;
  margin: 0 24rpx;
  background: #f0f0f0;
}

.editor-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e5e5e5;
}

.editor-avatar--fallback {
  display: block;
}

.editor-persona-thumb {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #f6f6f6;
  flex-shrink: 0;
}

.editor-textarea {
  width: 100%;
  min-height: 144rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  color: #111111;
  font-size: 26rpx;
  line-height: 1.6;
}

.editor-tag-list {
  margin-top: 18rpx;
  gap: 12rpx;
}

.editor-tag-chip {
  padding: 10rpx 18rpx;
  background: #ffffff;
  color: #5e6b7a;
  font-size: 22rpx;
}

.editor-save-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 10;
}

.editor-save-btn {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #3788e8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.editor-save-btn::after {
  border: none;
}
