<view class="page-shell" wx:if="{{viewModel}}">
  <view class="card tag-card" style="border-radius: 32rpx; overflow: hidden; background: #ffffff;">
    <view class="form-block">
      <view class="field-label">标签（最多 3 个，逗号分隔）</view>
      <input
        class="field-input"
        value="{{tagsInput}}"
        maxlength="40"
        placeholder="例如：路痴，INFJ，靠窗党"
        bindinput="handleInput"
      />
    </view>

    <view class="tag-list current-tags" wx:if="{{previewTags.length}}">
      <view class="tag-chip" wx:for="{{previewTags}}" wx:key="*this">{{item}}</view>
    </view>
    <view wx:else class="preview-empty">保存后会同步到首页成员列表和成员详情。</view>

    <button class="primary-btn save-btn" loading="{{submitting}}" bindtap="handleSave">
      保存标签
    </button>
  </view>
</view>
