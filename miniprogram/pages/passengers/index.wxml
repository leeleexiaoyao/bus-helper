<page-meta page-style="{{sheetVisible ? 'overflow: hidden;' : ''}}" />
<view class="page-shell passengers-page">
  <page-navbar title="乘客" progress="{{navProgress}}" theme="dark" leftPadding="{{32}}" titleFontSize="{{20}}" />

  <block wx:if="{{pageData}}">
    <view class="passengers-bg-hero"></view>

    <view class="passengers-topbar">
      <view class="passengers-page-title">乘客</view>
    </view>

    <view class="passengers-panel">
      <view class="passengers-filters">
        <view
          wx:for="{{filterOptions}}"
          wx:key="id"
          class="passengers-filter {{item.isSelected ? 'is-active' : ''}}"
          data-filter-id="{{item.id}}"
          bindtap="handleFilterChange"
        >
          <text>{{item.label}}</text>
          <image
            wx:if="{{item.isSelected}}"
            class="passengers-filter-line"
            src="/assets/icons/pic_tabbar_selectedline.svg"
            mode="widthFix"
          />
        </view>
      </view>

      <view class="passengers-groups">
        <view class="passenger-group" wx:for="{{visibleGroups}}" wx:key="tripId">
          <view class="passenger-group-head">
            <view class="passenger-group-title">{{item.tripLabel}}</view>
            <view class="passenger-group-count">{{item.memberCount}}人</view>
          </view>
          <member-list members="{{item.members}}" bindmembertap="handleMemberTap" />
        </view>
      </view>
    </view>
  </block>

  <seat-sheet
    visible="{{sheetVisible}}"
    mode="{{sheetMode}}"
    seat="{{null}}"
    member="{{selectedMember}}"
    tripLabel="{{pageData.currentTripLabel}}"
    bindclose="handleSheetClose"
    bindreleasemine="handleReleaseMine"
    bindadminrelease="handleAdminRelease"
    bindtogglefavorite="handleToggleFavorite"
  />
</view>
