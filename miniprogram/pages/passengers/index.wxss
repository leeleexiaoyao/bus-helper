.passengers-page {
  min-height: 100vh;
  position: relative;
  background: #f4f4f3;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
  overflow-x: hidden;
}

.passengers-bg-hero {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 454rpx;
  background: linear-gradient(180deg, #ecfbbb 0%, #f4f4f3 100%);
  pointer-events: none;
}

.passengers-topbar {
  margin-top: -44rpx;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.passengers-page-title {
  color: #111111;
  font-size: 56rpx;
  line-height: 1.18;
  font-weight: 900;
}

.passengers-panel {
  position: relative;
  z-index: 2;
  margin-top: 34rpx;
  padding: 28rpx 24rpx 32rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.7);
  box-sizing: border-box;
}

.passengers-filters {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding: 0 24rpx;
}

.passengers-filter {
  display: inline-flex;
  position: relative;
  align-items: center;
  justify-content: center;
  padding-bottom: 18rpx;
  box-sizing: border-box;
  color: #7c8390;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.2;
}

.passengers-filter.is-active {
  color: #111111;
  font-weight: 700;
}

.passengers-filter-line {
  position: absolute;
  left: 50%;
  bottom: -2rpx;
  width: 52rpx;
  transform: translateX(-50%);
}

.passengers-groups {
  padding: 28rpx 0 0;
}

.passenger-group + .passenger-group {
  margin-top: 32rpx;
}

.passenger-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}

.passenger-group-title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.passenger-group-count {
  color: #8c9199;
  font-size: 22rpx;
  line-height: 1.2;
}
