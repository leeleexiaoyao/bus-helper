<page-meta page-style="{{showAuthGate ? 'overflow: hidden;' : ''}}" />
<view class="page-shell profile-page">
  <page-navbar title="" progress="{{navProgress}}" />

  <block wx:if="{{pageData && !pageData.isAuthorized}}">
    <view class="profile-bg-hero">
      <image class="profile-flower" src="{{flowerIconUrl}}" mode="aspectFit" />
    </view>

    <view class="profile-topbar">
      <view class="profile-page-title">我的</view>
    </view>

    <view class="profile-unauth-card" bindtap="openAuthGate">
      <view class="profile-unauth-header">
        <image
          wx:if="{{pageData.currentUser.avatarUrl}}"
          class="profile-unauth-avatar-image"
          src="{{pageData.currentUser.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="profile-unauth-avatar"></view>
        <view class="profile-unauth-copy">
          <view class="profile-unauth-name">未登录</view>
          <view class="profile-unauth-tip">点击头像和昵称完成授权</view>
        </view>
      </view>
    </view>

    <view class="settings-card">
      <block wx:for="{{settingsItems}}" wx:key="id">
        <view
          wx:if="{{item.isShare}}"
          class="settings-item settings-item--share"
        >
          <view class="settings-item-main">
            <image class="settings-item-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="settings-item-label">{{item.label}}</text>
          </view>
          <view class="settings-item-arrow"></view>
          <button class="settings-share-trigger" open-type="share"></button>
        </view>

        <view
          wx:else
          class="settings-item"
          data-action="{{item.action}}"
          bindtap="handleMenuTap"
        >
          <view class="settings-item-main">
            <image class="settings-item-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="settings-item-label">{{item.label}}</text>
          </view>
          <view class="settings-item-arrow"></view>
        </view>

        <view wx:if="{{item.showDivider}}" class="settings-divider"></view>
      </block>
    </view>
  </block>

  <block wx:if="{{showProfileContent && pageData}}">
    <view class="profile-bg-hero">
      <image class="profile-flower" src="{{flowerIconUrl}}" mode="aspectFit" />
    </view>

    <view class="profile-topbar">
      <view class="profile-page-title">我的</view>
    </view>

    <view class="profile-hero {{hasProfileIllustration ? 'has-illustration' : ''}}">
      <view class="profile-copy">
        <view class="profile-head-row">
          <image
            wx:if="{{pageData.currentUser.avatarUrl}}"
            class="profile-avatar"
            src="{{pageData.currentUser.avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="profile-avatar profile-avatar--fallback avatar-fallback">{{pageData.currentUserInitial}}</view>

          <view class="profile-main">
            <view class="profile-name">{{pageData.currentUser.nickname}}</view>
            <view class="profile-seat">座位号:{{pageData.currentSeatLabel}}</view>
          </view>

          <view class="profile-edit-btn" bindtap="goTagEditor">
            <text class="profile-edit-text">编辑资料</text>
          </view>
        </view>

        <view class="profile-tags" wx:if="{{profileTagViews.length}}">
          <view
            class="profile-tag"
            wx:for="{{profileTagViews}}"
            wx:key="label"
            style="{{item.style}}"
          >
            {{item.label}}
          </view>
        </view>

        <view wx:if="{{hasProfileBio}}" class="profile-bio">{{pageData.currentUser.bio}}</view>

        <view wx:if="{{hasProfileStats}}" class="profile-stats">
          <view wx:if="{{profileStats.age.primary}}" class="profile-stat">
            <view class="profile-stat-value {{profileStats.age.isPlaceholder ? 'profile-stat-value--placeholder' : ''}}">
              <text>{{profileStats.age.primary}}</text>
            </view>
            <view class="profile-stat-label">年龄</view>
          </view>
          <view wx:if="{{profileStats.age.primary && (profileStats.living.primary || profileStats.hometown.primary)}}" class="profile-stat-divider"></view>
          <view wx:if="{{profileStats.living.primary}}" class="profile-stat">
            <view class="profile-stat-value {{profileStats.living.isPlaceholder ? 'profile-stat-value--placeholder' : ''}}">
              <text>{{profileStats.living.primary}}</text>
            </view>
            <view class="profile-stat-label">居住</view>
          </view>
          <view wx:if="{{profileStats.hometown.primary && (profileStats.age.primary || profileStats.living.primary)}}" class="profile-stat-divider"></view>
          <view wx:if="{{profileStats.hometown.primary}}" class="profile-stat">
            <view class="profile-stat-value {{profileStats.hometown.isPlaceholder ? 'profile-stat-value--placeholder' : ''}}">
              <text>{{profileStats.hometown.primary}}</text>
            </view>
            <view class="profile-stat-label">来自</view>
          </view>
        </view>
      </view>

      <image wx:if="{{hasProfileIllustration}}" class="profile-illustration" src="{{profileIllustrationUrl}}" mode="aspectFit" />
    </view>

    <view class="settings-card">
      <block wx:for="{{settingsItems}}" wx:key="id">
        <view
          wx:if="{{item.isShare}}"
          class="settings-item settings-item--share"
        >
          <view class="settings-item-main">
            <image class="settings-item-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="settings-item-label">{{item.label}}</text>
          </view>
          <view class="settings-item-arrow"></view>
          <button class="settings-share-trigger" open-type="share"></button>
        </view>

        <view
          wx:else
          class="settings-item"
          data-action="{{item.action}}"
          bindtap="handleMenuTap"
        >
          <view class="settings-item-main">
            <image class="settings-item-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="settings-item-label">{{item.label}}</text>
          </view>
          <view class="settings-item-arrow"></view>
        </view>

        <view wx:if="{{item.showDivider}}" class="settings-divider"></view>
      </block>
    </view>
  </block>

  <view wx:if="{{pageData}}" class="seed-data-card">
    <view class="seed-data-copy">
      <view class="seed-data-title">假数据</view>
      <view class="seed-data-description">开启后自动填充 40 个完整用户和座位数据</view>
    </view>
    <switch
      class="seed-data-switch"
      color="#2f7cff"
      checked="{{pageData.seedDemoEnabled}}"
      disabled="{{seedDemoToggling}}"
      bindchange="handleSeedDemoToggle"
    />
  </view>

  <view wx:if="{{pageData && pageData.seedDemoEnabled}}" class="seed-role-card">
    <view class="seed-role-header">
      <view class="seed-role-title">角色切换</view>
      <view class="seed-role-description">默认提供管理员和普通成员两个身份</view>
    </view>

    <view
      class="seed-role-item"
      wx:for="{{pageData.demoUsers}}"
      wx:key="id"
    >
      <view class="seed-role-main">
        <image
          wx:if="{{item.avatarUrl}}"
          class="seed-role-avatar"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="seed-role-avatar seed-role-avatar--fallback">{{item.initial}}</view>
        <view class="seed-role-copy">
          <view class="seed-role-name-row">
            <view class="seed-role-name">{{item.nickname}}</view>
            <view class="seed-role-badge">{{item.roleLabel}}</view>
          </view>
          <view class="seed-role-trip">{{item.currentTripName}}</view>
        </view>
      </view>
      <view
        class="seed-role-switch {{item.isActive ? 'is-active' : ''}}"
        data-user-id="{{item.id}}"
        bindtap="handleSwitchSeedDemoUser"
      >
        {{item.switchLabel}}
      </view>
    </view>
  </view>

  <block wx:if="{{showAuthGate}}">
    <view class="profile-auth-mask" bindtap="handleCloseAuthGate"></view>
    <view class="profile-auth-sheet">
      <auth-gate
        displayMode="sheet"
        title="获取你的头像、昵称"
        subtitle="用于生成账号信息"
        buttonText="保存"
        presetNickname="{{authPresetNickname}}"
        presetAvatarUrl="{{authPresetAvatarUrl}}"
        bindauthorized="handleAuthorizeProfile"
      />
    </view>
  </block>
</view>
