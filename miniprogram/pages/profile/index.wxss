.profile-page {
  min-height: 100vh;
  position: relative;
  padding-top: 0;
  padding-bottom: 48rpx;
  background: #f5f6f9;
}

.profile-hero {
  position: relative;
  min-height: 520rpx;
  padding: 34rpx 10rpx 0;
}

.profile-avatar,
.demo-avatar {
  width: 114rpx;
  height: 114rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #d6d6d8;
}

.profile-avatar--fallback,
.demo-avatar--fallback {
  display: block;
}

.profile-head-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-copy {
  position: relative;
  z-index: 2;
  margin-right: 246rpx;
}

.profile-name {
  margin-top: 30rpx;
  color: rgba(0, 0, 0, 0.82);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.18;
}

.profile-seat {
  margin-top: 10rpx;
  color: rgba(0, 0, 0, 0.3);
  font-size: 24rpx;
  line-height: 1.4;
}

.profile-edit-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 46rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  box-sizing: border-box;
}

.profile-edit-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.profile-edit-text {
  color: rgba(0, 0, 0, 0.32);
  font-size: 24rpx;
  line-height: 1;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 26rpx;
}

.profile-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 36rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(43, 145, 255, 0.2);
  border-radius: 8rpx;
  background: rgba(43, 145, 255, 0.1);
  color: #2b91ff;
  font-size: 22rpx;
  box-sizing: border-box;
}

.profile-bio {
  margin-top: 24rpx;
  max-width: 100%;
  color: rgba(0, 0, 0, 0.48);
  font-size: 26rpx;
  line-height: 1.4;
  min-height: 36rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-stats {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  margin-top: 66rpx;
  padding-left: 0;
  transform: translateX(-24rpx);
}

.profile-stat {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.profile-stat-value {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
  max-width: 100%;
  color: rgba(0, 0, 0, 0.82);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-stat-value--placeholder {
  font-size: 26rpx;
}

.profile-stat-value-secondary {
  font-size: 22rpx;
  line-height: 1.2;
  opacity: 0.72;
}

.profile-stat-label {
  margin-top: 10rpx;
  color: rgba(0, 0, 0, 0.3);
  font-size: 22rpx;
  line-height: 1.2;
}

.profile-stat-divider {
  align-self: center;
  width: 1rpx;
  height: 42rpx;
  background: rgba(0, 0, 0, 0.08);
}

.profile-illustration {
  position: absolute;
  right: 34rpx;
  bottom: 10rpx;
  width: 196rpx;
  height: 196rpx;
  z-index: 1;
}

.settings-card {
  margin-top: -6rpx;
  padding: 22rpx 16rpx 12rpx;
  border-radius: 36rpx;
  background: #ffffff;
}

.settings-title,
.card-title {
  color: #111111;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.3;
}

.settings-title {
  margin: 0 12rpx 18rpx;
}

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 12rpx;
  background: transparent;
  box-sizing: border-box;
}

.settings-item--share {
  position: relative;
}

.settings-item-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.settings-item-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.settings-item-label {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.4;
}

.settings-share-trigger {
  position: absolute;
  inset: 0;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.settings-share-trigger::after {
  border: none;
}

.settings-item-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid rgba(26, 26, 26, 0.42);
  border-right: 2rpx solid rgba(26, 26, 26, 0.42);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.settings-divider {
  height: 1rpx;
  margin: 0 12rpx;
  background: rgba(0, 0, 0, 0.06);
}

.profile-action {
  margin: 24rpx 0 0;
  position: relative;
  z-index: 1;
}

.demo-card {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  position: relative;
  z-index: 1;
  border-radius: 32rpx;
  overflow: hidden;
  background: #ffffff;
}

.demo-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(190, 205, 222, 0.62);
}

.demo-item:first-of-type {
  margin-top: 10rpx;
}

.demo-main {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex: 1;
}

.demo-copy {
  flex: 1;
}

.demo-name {
  font-size: 26rpx;
  font-weight: 600;
}

.demo-active {
  margin-left: 10rpx;
  color: #ff6b3d;
  font-size: 20rpx;
}

.demo-trip {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.demo-switch {
  width: auto;
  margin: 0;
  flex-shrink: 0;
}
