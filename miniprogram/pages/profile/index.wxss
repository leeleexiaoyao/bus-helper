.profile-page {
  min-height: 100vh;
  position: relative;
  padding-top: 40rpx;
  padding-bottom: 40rpx;
  background: linear-gradient(180deg, #8dbaf5 0%, #97bff4 18%, #b7d1f6 38%, #dbe8fb 58%, #ffffff 82%);
}

.profile-head {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 0 4rpx 0;
  position: relative;
  z-index: 1;
}

.profile-avatar,
.demo-avatar {
  width: 114rpx;
  height: 114rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.profile-avatar--fallback,
.demo-avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff9d7b 0%, #ff7648 100%);
  color: #fff8f2;
  font-size: 32rpx;
  font-weight: 700;
}

.profile-copy {
  flex: 1;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 700;
}

.profile-seat,
.profile-trip {
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.tags-card,
.section-card,
.demo-card {
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
  position: relative;
  z-index: 1;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
}

.card-link,
.menu-arrow {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.card-empty {
  margin-top: 18rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.7;
}

.tags-card .tag-list {
  margin-top: 18rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-top: 1rpx solid rgba(190, 205, 222, 0.62);
}

.menu-item--last {
  padding-bottom: 0;
}

.menu-label {
  font-size: 28rpx;
  font-weight: 500;
}

.profile-action {
  margin: 32rpx auto 0;
  width: 280rpx;
  position: relative;
  z-index: 1;
}

.demo-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(190, 205, 222, 0.62);
}

.demo-item:first-of-type {
  margin-top: 10rpx;
}

.demo-main {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex: 1;
}

.demo-copy {
  flex: 1;
}

.demo-name {
  font-size: 26rpx;
  font-weight: 600;
}

.demo-active {
  margin-left: 10rpx;
  color: #ff6b3d;
  font-size: 20rpx;
}

.demo-trip {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.demo-switch {
  width: 150rpx;
}
