<view class="trip-settings-page" wx:if="{{settings}}">
  <view class="settings-content">
    <view class="setting-row">
      <view class="setting-label">行程名称</view>
      <view class="setting-value">{{settings.tripName}}</view>
    </view>

    <view class="setting-row">
      <view class="setting-label">出发时间</view>
      <view class="setting-value setting-value--muted">{{settings.departureTime}}</view>
    </view>

    <view class="setting-row">
      <view class="setting-label">车次口令</view>
      <view class="password-control">
        <text class="password-text">{{settings.password}}</text>
        <button class="copy-button" hover-class="none" bindtap="handleCopyPassword">
          <view class="copy-icon"></view>
        </button>
      </view>
    </view>

    <view class="setting-row">
      <view class="setting-label">座位模板</view>
      <view class="setting-value">{{templateLabel}}</view>
    </view>

    <button class="danger-btn dissolve-btn" bindtap="handleDissolve">解散车次</button>
  </view>
</view>
