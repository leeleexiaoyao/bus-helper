.boarding-records-page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: #f4f4f3;
  box-sizing: border-box;
}

.record-group,
.record-item {
  border-radius: 32rpx;
  background: #ffffff;
  padding: 28rpx 28rpx;
  box-sizing: border-box;
}

.record-group + .record-group,
.record-item + .record-item {
  margin-top: 20rpx;
}

.record-filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.record-filter-chip {
  min-width: 92rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.06);
  color: #6f7783;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}

.record-filter-chip.is-active {
  background: #d8f940;
  color: #111111;
}

.record-member-head,
.record-item {
  display: flex;
  align-items: center;
}

.record-seat {
  min-width: 88rpx;
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.record-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #dde8ef;
}

.record-member-copy,
.record-item-copy {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.record-name {
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.record-trip {
  margin-top: 8rpx;
  color: #8c9199;
  font-size: 22rpx;
  line-height: 1.2;
}

.record-entry {
  margin-top: 18rpx;
  margin-left: 182rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f1f3f6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.record-entry-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #d8f940;
  color: #111111;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  box-sizing: border-box;
}

.record-entry-time,
.record-item-time {
  color: #6f7783;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: right;
}

.record-item-time {
  margin-left: 16rpx;
}

.record-empty {
  margin-top: 120rpx;
  color: #8c9199;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: center;
}
