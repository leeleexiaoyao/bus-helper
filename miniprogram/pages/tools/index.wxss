.page-shell.tools-page {
  min-height: 100vh;
  position: relative;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: #f4f4f3;
  box-sizing: border-box;
  overflow-x: hidden;
}

.tools-bg-hero {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 454rpx;
  background: linear-gradient(180deg, #ecfbbb 0%, #f4f4f3 100%);
  pointer-events: none;
  z-index: 0;
}

.tools-header {
  margin-top: -44rpx;
  position: relative;
  z-index: 1;
}

.tools-title {
  color: #111111;
  font-size: 56rpx;
  line-height: 1.18;
  font-weight: 900;
}

.tools-subtitle {
  margin-top: 10rpx;
  color: #6f7783;
  font-size: 24rpx;
  line-height: 1.38;
}

.tools-empty-state {
  margin-top: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 36rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.76);
  position: relative;
  z-index: 1;
}

.tools-empty-label {
  color: #2a3234;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}
