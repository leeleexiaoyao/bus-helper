.page-shell.tools-page {
  min-height: 100vh;
  padding: 0 24rpx 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

auth-gate {
  display: block;
  margin-top: 24rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, fit-content(100%));
  gap: 24rpx;
  margin-top: 24rpx;
}

.tool-card {
  position: relative;
  min-height: 222rpx;
  padding: 24rpx;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  overflow: hidden;
  box-sizing: border-box;
}

.tool-card.is-clickable {
  cursor: pointer;
}

.tool-card-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 100%;
}

.tool-title {
  color: #000000;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.tool-description {
  margin-top: 12rpx;
  max-width: 180rpx;
  color: #666666;
  font-size: 24rpx;
  line-height: 1.5;
}

.tool-cta {
  margin-top: auto;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 22rpx;
  line-height: 1.2;
}

.tool-image {
  position: absolute;
  right: 0;
  bottom: -40rpx;
  width: 144rpx;
  z-index: 0;
}

.tool-card--vote {
  background: #fef3d1;
  border-color: #ffe3aa;
}

.tool-card--vote .tool-cta {
  color: #cd9c05;
}

.tool-card--seat-draw {
  background: #d3eafd;
  border-color: #b6deff;
}

.tool-card--seat-draw .tool-cta {
  color: #2e84cb;
}

.tool-card--lottery {
  background: #daf9f1;
  border-color: #c0f8ed;
}

.tool-card--lottery .tool-cta {
  color: #369c82;
}

.tool-card--wheel {
  background: #fee2f4;
  border-color: #f5cfec;
}

.tool-card--wheel .tool-cta {
  color: #d42a97;
}
