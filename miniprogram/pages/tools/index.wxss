.tools-page {
  min-height: 100vh;
  position: relative;
  padding-top: 28rpx;
  padding-bottom: 40rpx;
  background: linear-gradient(180deg, #8dbaf5 0%, #97bff4 18%, #b7d1f6 38%, #dbe8fb 58%, #ffffff 82%);
}

auth-gate {
  display: block;
  margin: 0 20rpx;
  position: relative;
  z-index: 1;
}

.tools-hero {
  margin: 0 20rpx 18rpx;
  position: relative;
  z-index: 1;
}

.hero-eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.hero-title {
  margin-top: 4rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.15;
}

.hero-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}

.hero-btn {
  margin-top: 16rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin: 0 20rpx;
  position: relative;
  z-index: 1;
}

.tool-card {
  min-height: 240rpx;
  padding: 22rpx 20rpx 24rpx;
}

.tool-card.is-clickable {
  cursor: pointer;
}

.tool-card-top {
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  gap: 20rpx;
}

.tool-card-body {
  margin-top: 16rpx;
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.tool-icon.is-seat-draw {
  background: rgba(255, 166, 72, 0.16);
  color: #f49a27;
}

.tool-icon.is-vote {
  background: rgba(63, 111, 252, 0.12);
  color: #3f6ffc;
}

.tool-icon.is-wheel {
  background: rgba(255, 83, 54, 0.12);
  color: var(--brand);
}

.tool-icon.is-lottery {
  background: rgba(39, 188, 129, 0.14);
  color: #18a567;
}

.tool-title {
  font-size: 32rpx;
  font-weight: 700;
}

.tool-description {
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.tool-state {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f5f6;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.tool-state.is-active {
  background: rgba(255, 83, 54, 0.12);
  color: var(--brand);
}

.tool-helper {
  margin-top: 20rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.tools-btn {
  width: 100%;
}
