<view class="page-shell tools-page">
  <page-navbar title="工具" progress="{{navProgress}}" />

  <block wx:if="{{showAuthGate}}">
    <auth-gate
      title="先完成模拟授权"
      subtitle="先用演示身份完成模拟授权，后面才能进入工具区；等主流程跑通后再切回真实微信授权。"
      presetNickname="{{authPresetNickname}}"
      presetAvatarUrl="{{authPresetAvatarUrl}}"
      bindauthorized="handleAuthorizeProfile"
    />
  </block>

  <block wx:if="{{showToolsContent}}">
    <view class="tools-hero">
      <view class="hero-eyebrow">当前车次</view>
      <view class="hero-title">{{pageData.tripName}}</view>
      <view class="hero-meta">你的角色：{{pageData.viewerRoleLabel}}</view>
      <button wx:if="{{showGoHomeAction}}" class="secondary-btn tools-btn hero-btn" bindtap="goHome">
        去首页创建或加入
      </button>
    </view>

    <view class="tool-grid">
      <view
        class="card tool-card {{item.canEnter ? 'is-clickable' : ''}}"
        wx:for="{{pageData.toolCards}}"
        wx:key="type"
        data-tool-type="{{item.type}}"
        bindtap="handleEnterTool"
      >
        <view class="tool-card-top">
          <view class="{{item.iconClassName}}">{{item.iconGlyph}}</view>
        </view>
        <view class="tool-card-body">
          <view class="tool-title">{{item.title}}</view>
          <view class="tool-description">{{item.description}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
