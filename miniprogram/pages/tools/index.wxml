<view class="page-shell tools-page">
  <view class="tools-bg-hero"></view>
  <page-navbar title="" progress="{{navProgress}}" />

  <block wx:if="{{showAuthGate}}">
    <auth-gate
      title="先完成微信授权"
      subtitle="先完成微信头像和昵称授权，后面才能进入工具区。"
      presetNickname="{{authPresetNickname}}"
      presetAvatarUrl="{{authPresetAvatarUrl}}"
      bindauthorized="handleAuthorizeProfile"
    />
  </block>

  <block wx:if="{{showToolsContent}}">
    <view class="tools-header">
      <view class="tools-title">工具箱</view>
      <view class="tools-subtitle">趣味小工具，认座更轻松</view>
    </view>

    <view class="tool-grid">
      <view
        class="tool-card tool-card--{{item.themeKey}} {{item.canEnter ? 'is-clickable' : ''}}"
        wx:for="{{pageData.toolCards}}"
        wx:key="type"
        data-tool-type="{{item.type}}"
        bindtap="handleEnterTool"
      >
        <view class="tool-card-body">
          <view class="tool-title">{{item.displayTitle}}</view>
          <view class="tool-description">{{item.displayDescription}}</view>
        </view>
        <view class="tool-cta">
          <text>{{item.ctaLabel}}</text>
          <image class="tool-cta-icon" src="/assets/icons/icon_tools_arrow.svg" mode="aspectFit" />
        </view>
        <image class="tool-image" src="{{item.imageUrl}}" mode="widthFix" />
      </view>
    </view>
  </block>
</view>
