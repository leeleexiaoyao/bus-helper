.favorites-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4f4f3;
  padding: 0 0 calc(env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
}

.favorites-content {
  flex: 1;
  min-height: 0;
  padding: 28rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

auth-gate {
  display: block;
}

.favorites-tabs {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 0;
}

.favorites-tab {
  min-width: 168rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.06);
  color: #666666;
  font-size: 26rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.favorites-tab.is-active {
  background: #111111;
  color: #ffffff;
}

.favorites-list,
.ranking-list {
  padding: 24rpx 0 0;
}

.favorite-card,
.ranking-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.favorite-avatar,
.ranking-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.favorite-avatar--fallback,
.ranking-avatar--fallback {
  display: block;
}

.favorite-main,
.ranking-main {
  flex: 1;
  min-width: 0;
}

.favorite-title-row,
.ranking-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.favorite-name,
.ranking-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.favorite-seat,
.ranking-seat {
  font-size: 24rpx;
  color: #7b7b7b;
  flex-shrink: 0;
}

.favorite-badge {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.favorite-mutual-tag {
  padding: 0 16rpx;
  height: 42rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brand);
  background: #ffffff;
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
}

.favorite-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.favorite-tag-chip {
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ranking-index {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  background: #111111;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ranking-count {
  min-width: 112rpx;
  padding: 12rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(43, 145, 255, 0.08);
  text-align: center;
  box-sizing: border-box;
}

.ranking-count-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b91ff;
}

.ranking-count-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #6e8aa8;
}

.favorites-empty {
  flex: 1;
  min-height: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

.favorites-empty--solo {
  padding-bottom: 8rpx;
}

.favorites-empty-title {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.6;
  color: #b0b0b0;
}
