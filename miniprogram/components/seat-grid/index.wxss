.seat-grid {
  width: 100%;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.seat-rows {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.seat-row {
  display: block;
}

.row-slots {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 16rpx;
}

.seat-card {
  min-height: 206rpx;
  padding: 26rpx 8rpx 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}

.seat-card.is-empty {
  background: #ffffff;
}

.seat-empty {
  color: #c6c8cb;
  font-size: 24rpx;
  font-weight: 400;
}

.seat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.seat-avatar-shell {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seat-avatar-shell--empty {
  margin-top: 2rpx;
}

.seat-avatar--fallback {
  display: block;
  background: transparent;
  box-shadow: none;
}

.seat-badge {
  position: absolute;
  top: 84rpx;
  left: 16rpx;
  min-width: 58rpx;
  height: 26rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: #f4c433;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.seat-name {
  margin-top: 14rpx;
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 400;
  color: #000000;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
}

.seat-code {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a8a8a8;
}

.seat-code--empty {
  margin-top: 12rpx;
}

.seat-empty-placeholder {
  width: 68rpx;
  height: 18rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: rgba(217, 217, 217, 0.34);
}

.aisle {
  min-height: 206rpx;
}
