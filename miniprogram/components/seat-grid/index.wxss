.seat-grid {
  width: 100%;
  padding: 24rpx 0 8rpx;
  box-sizing: border-box;
}

.seat-grid-frame {
  position: relative;
}

.seat-grid-aisle-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 130rpx;
  pointer-events: none;
  z-index: 0;
}

.seat-grid-aisle-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: repeating-linear-gradient(
    to bottom,
    #d7dce5 0,
    #d7dce5 16rpx,
    transparent 16rpx,
    transparent 30rpx
  );
}

.seat-grid-aisle-line--left {
  left: calc(50% - 49rpx);
}

.seat-grid-aisle-line--right {
  left: calc(50% + 49rpx);
}

.seat-rows {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  position: relative;
  z-index: 1;
}

.seat-row {
  display: block;
}

.row-slots {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 18rpx;
}

.seat-card {
  min-height: 104rpx;
  width: calc(100% - 32rpx);
  justify-self: center;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}

.seat-shell-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.seat-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.seat-avatar-badge {
  position: absolute;
  top: 6rpx;
  right: -2rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.seat-avatar--fallback {
  display: block;
  background: #6fb9ff;
}

.seat-badge {
  position: absolute;
  top: 6rpx;
  right: -2rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-sizing: border-box;
}

.seat-code {
  position: relative;
  z-index: 1;
  max-width: 100%;
  text-align: center;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
  color: #9aa1a9;
}

.seat-card.is-occupied .seat-code {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.seat-card.is-mine .seat-code,
.seat-card.is-admin .seat-code {
  color: #111111;
}

.aisle {
  min-height: 104rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.aisle-label {
  position: relative;
  z-index: 1;
  color: #9aa1a9;
  font-size: 22rpx;
  line-height: 1;
  padding: 0;
}
