.page-navbar-spacer {
  width: 100%;
}

.page-navbar-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  box-sizing: border-box;
  pointer-events: none;
}

.page-navbar-bg {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.95);
  border-bottom: 1rpx solid rgba(17, 17, 17, 0.04);
}

.page-navbar-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  padding-bottom: 4px;
}

.page-navbar-title {
  width: 100%;
  text-align: left;
  color: #111111;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
