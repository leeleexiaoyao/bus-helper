.trip-header {
  padding: 28rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-main {
  flex: 1;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #c6c8cb;
  font-size: 22rpx;
}

.role-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f2e8dd;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 600;
}

.role-chip.is-admin {
  background: rgba(32, 91, 143, 0.12);
  color: var(--admin);
}

.viewer-seat {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff1e8 0%, #f8dfd1 100%);
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.stat-card {
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  overflow: hidden;
}

.stat-label {
  font-size: 20rpx;
  color: #c6c8cb;
}

.stat-value {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.action-btn {
  margin-top: 24rpx;
}
