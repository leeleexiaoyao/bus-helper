.sheet-mask {
  position: fixed;
  inset: 0;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  opacity: 0;
  transition: opacity 0.22s ease;
}

.sheet-mask.is-active {
  opacity: 1;
}

.sheet-panel {
  width: 100%;
  max-width: 666rpx;
  padding: 18rpx 18rpx 22rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: none;
  transform: translateY(56rpx);
  opacity: 0.98;
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.sheet-mask.is-active .sheet-panel {
  transform: translateY(0);
  opacity: 1;
}

.sheet-panel--detail {
  padding: 0 0 42rpx;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.08);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.sheet-title--compact {
  margin-top: 8rpx;
}

.sheet-subtitle {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.claim-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 28rpx 0 8rpx;
}

.claim-avatar,
.detail-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
}

.claim-avatar--fallback,
.detail-avatar--fallback {
  display: block;
}

.claim-copy {
  text-align: left;
}

.claim-name {
  font-size: 26rpx;
  font-weight: 600;
}

.claim-seat {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.sheet-action {
  margin-top: 22rpx;
}

.sheet-actions-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.sheet-footer-btn {
  flex: 1;
  margin: 0;
  height: 88rpx;
  padding: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  background-color: #e6e6e6;
  color: #797979;
}

.sheet-footer-btn::after {
  border: none;
}

.sheet-footer-btn--full {
  flex: none;
  width: 100%;
}

.sheet-footer-btn--strong {
  font-weight: 700;
}

.sheet-footer-btn--cancel {
  background: #e6e6e6;
  color: #797979;
}

.sheet-footer-btn--primary {
  background: #ff5336;
  color: #ffffff;
}

.sheet-footer-btn--danger {
  background: #ff4527;
  color: #ffffff;
}

.detail-card {
  margin-top: 20rpx;
  text-align: center;
}

.detail-line {
  display: flex;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.mini-tag {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.mini-tag--admin {
  background: #111111;
}

.detail-shell {
  padding: 4rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 40rpx;
  background: #ffffff;
}

.detail-hero {
  position: relative;
  min-height: 320rpx;
  padding: 32rpx 24rpx 26rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e2ecfd 0%, #f4f8ff 100%);
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 180rpx;
  overflow: hidden;
}

.detail-hero-content {
  position: relative;
  z-index: 2;
  width: 280rpx;
}

.detail-user-head {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  overflow: hidden;
}

.detail-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.detail-avatar--fallback {
  display: block;
}

.detail-main {
  margin-top: 10rpx;
}

.detail-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.detail-name {
  color: #202020;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.detail-seat {
  color: #202020;
  font-size: 28rpx;
  line-height: 1.3;
}

.detail-bio {
  margin-top: 8rpx;
  color: #202020;
  font-size: 24rpx;
  line-height: 1.7;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.detail-tags {
  margin-top: 14rpx;
  gap: 16rpx;
}

.detail-tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
  transform: translateY(2rpx);
}

.mini-tag--mutual {
  width: auto;
  min-width: 0;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 122, 89, 0.14);
  color: #ff7a59;
  font-size: 20rpx;
}

.detail-figure {
  position: absolute;
  right: -6rpx;
  bottom: 0;
  z-index: 1;
  height: 286rpx;
}

.detail-stats {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 34rpx 30rpx;
}

.detail-stat-item {
  flex: 1;
  min-width: 0;
}

.detail-stat-item--age {
  flex: 0.7;
}

.detail-stat-value {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  color: #202020;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.detail-stat-value--placeholder {
  font-weight: 500;
}

.detail-stat-value-secondary {
  font-size: 20rpx;
  line-height: 1.4;
  opacity: 0.68;
}

.detail-stat-label {
  margin-top: 8rpx;
  color: #949494;
  font-size: 22rpx;
}

.detail-close-btn {
  margin-top: 20rpx;
  width: calc(100% - 36rpx);
  margin-left: 18rpx;
  margin-right: 18rpx;
}
