.auth-gate {
  padding: 36rpx 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 17, 17, 0.05);
  overflow: hidden;
  box-shadow: none;
}

.auth-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 83, 54, 0.1);
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 600;
}

.auth-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2a37;
}

.auth-subtitle {
  margin-top: 10rpx;
  color: #6e7f92;
  font-size: 22rpx;
  line-height: 1.6;
}

.auth-note {
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #f7f7f7;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.7;
}

.auth-form {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.auth-avatar-picker {
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #f3f6f9;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-avatar-picker::after {
  border: none;
}

.auth-avatar-image {
  width: 100%;
  height: 100%;
}

.auth-avatar-placeholder {
  color: #6e7f92;
  font-size: 24rpx;
}

.auth-input {
  flex: 1;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f7f7f7;
  color: #1f2a37;
  font-size: 28rpx;
}

.auth-btn {
  margin-top: 28rpx;
}
