.auth-gate {
  padding: 36rpx 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 17, 17, 0.05);
  overflow: hidden;
  box-shadow: none;
}

.auth-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 83, 54, 0.1);
  color: var(--brand-deep);
  font-size: 20rpx;
  font-weight: 600;
}

.auth-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2a37;
}

.auth-subtitle {
  margin-top: 10rpx;
  color: #6e7f92;
  font-size: 22rpx;
  line-height: 1.6;
}

.auth-note {
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #f7f7f7;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.7;
}

.auth-btn {
  margin-top: 28rpx;
  width: 100%;
  border-radius: 24rpx;
  line-height: 88rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #ff5336;
  color: #ffffff;
}
