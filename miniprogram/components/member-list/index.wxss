.member-list {
  padding: 24rpx 0 0;
}

.member-item {
  display: flex;
  gap: 14rpx;
  align-items: center;
  min-height: 138rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.member-avatar--fallback {
  display: block;
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-seat {
  color: #7f7f7f;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.member-role-badge {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.member-tag-chip {
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transform: translateY(2rpx);
}
