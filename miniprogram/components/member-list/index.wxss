.member-list {
  padding: 24rpx 24rpx 0;
}

.member-item {
  display: flex;
  gap: 14rpx;
  align-items: center;
  min-height: 138rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.member-avatar--fallback {
  display: block;
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-seat {
  color: #7f7f7f;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.member-role-pill {
  min-width: 58rpx;
  height: 26rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: #f4c433;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.member-tag-chip {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(43, 145, 255, 0.2);
  background: rgba(43, 145, 255, 0.1);
  color: #2b91ff;
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
