<view class="member-list">
  <view class="member-item" wx:for="{{members}}" wx:key="userId" wx:for-item="member" wx:for-index="memberIndex" data-index="{{memberIndex}}" bindtap="handleMemberTap">
    <image wx:if="{{member.avatarUrl}}" class="member-avatar" src="{{member.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="member-avatar member-avatar--fallback avatar-fallback">{{member.initial}}</view>

    <view class="member-main">
      <view class="member-title-row">
        <view class="member-name">{{member.nickname}}</view>
        <view wx:if="{{member.isSelf}}" class="member-role-badge">我</view>
        <view wx:if="{{member.isAdmin}}" class="member-role-badge">管</view>
      </view>

      <view class="tag-list" wx:if="{{member.tagViews.length}}">
        <block wx:for="{{member.tagViews}}" wx:key="label" wx:for-item="tag">
          <view class="member-tag-chip" style="{{tag.style}}">{{tag.label}}</view>
        </block>
      </view>
    </view>

    <view class="member-seat">{{member.seatDisplayLabel || member.seatLabel}}</view>
  </view>
</view>
