<view class="member-list">
  <view class="member-item" wx:for="{{members}}" wx:key="userId" wx:for-item="member" wx:for-index="memberIndex" data-index="{{memberIndex}}" bindtap="handleMemberTap">
    <image wx:if="{{member.avatarUrl}}" class="member-avatar" src="{{member.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="member-avatar member-avatar--fallback avatar-fallback">{{member.initial}}</view>

    <view class="member-main">
      <view class="member-title-row">
        <view class="member-name">{{member.nickname}}</view>
        <view wx:if="{{member.isAdmin}}" class="member-role-pill">管理</view>
      </view>

      <view class="tag-list" wx:if="{{member.tags.length}}">
        <block wx:for="{{member.tags}}" wx:key="*this" wx:for-item="tag" wx:for-index="tagIndex">
          <view class="member-tag-chip" wx:if="{{tagIndex < 2}}">{{tag}}</view>
        </block>
      </view>
    </view>

    <view class="member-seat">{{member.seatLabel}}</view>
  </view>
</view>
