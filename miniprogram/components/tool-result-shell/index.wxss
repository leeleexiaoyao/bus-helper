.tool-result-card {
  margin-top: 40rpx;
  padding: 32rpx 30rpx 36rpx;
  border: none;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(148, 163, 184, 0.06);
  box-sizing: border-box;
}

.tool-result-heading {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.tool-result-title {
  position: relative;
  z-index: 1;
  color: #111111;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.tool-result-title-accent {
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 156rpx;
  height: 36rpx;
}

.result-empty {
  margin-top: 18rpx;
  margin-bottom: 16rpx;
  color: #9aa1af;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.6;
  text-align: center;
}

.seat-draw-result-card {
  padding-top: 28rpx;
}
